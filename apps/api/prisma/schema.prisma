generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Modelo principal para tutores/docentes de la plataforma
/// Representa a los usuarios educadores que crean y gestionan contenido educativo
model Tutor {
  /// Identificador único del tutor (CUID para mejor distribución)
  id                      String                  @id @default(cuid())
  /// Username único del tutor - usado para autenticación alternativa
  username                String?                 @unique
  /// Email único del tutor - usado para autenticación
  /// IMPORTANTE: Debe estar indexado para búsquedas rápidas en login
  email                   String?                 @unique
  /// Hash bcrypt de la contraseña - NUNCA se envía al frontend
  /// Se maneja solo en backend para seguridad
  passwordHash            String                  @map("password_hash")
  /// Indica si el tutor debe completar su perfil (datos personales adicionales)
  debeCompletarPerfil     Boolean                 @default(false) @map("debe_completar_perfil")
  /// Fecha del último cambio de contraseña
  fechaUltimoCambio       DateTime?               @map("fecha_ultimo_cambio")
  /// Nombre del tutor
  nombre                  String
  /// Apellido del tutor
  apellido                String
  /// Documento Nacional de Identidad (opcional)
  dni                     String?
  /// CUIL/CUIT para facturación (REQUERIDO para inscripciones 2026)
  cuil                    String?
  /// Teléfono de contacto (opcional)
  telefono                String?
  /// Fecha en que el tutor se registró en la plataforma
  fechaRegistro           DateTime                @default(now()) @map("fecha_registro")
  /// Indica si el tutor completó el proceso de onboarding inicial
  /// Se usa para redirigir a nuevos tutores al flujo de configuración
  haCompletadoOnboarding  Boolean                 @default(false) @map("ha_completado_onboarding")
  /// Timestamp de creación del registro
  createdAt               DateTime                @default(now())
  /// Timestamp de última actualización del registro
  updatedAt               DateTime                @updatedAt
  /// Roles asignados al tutor (normalmente solo ["tutor"])
  /// Ejemplo: ["tutor"]
  roles                   Json                    @default("[\"tutor\"]")
  estudiantes             Estudiante[]
  inscripcionesClase      InscripcionClase[]
  inscripcionesClaseGrupo InscripcionClaseGrupo[]
  inscripcionesMensuales  InscripcionMensual[]

  /// COLONIA DE VERANO
  inscripcionesColonia ColoniaInscripcion[]

  /// SUSCRIPCIONES RECURRENTES (PreApproval MercadoPago)
  suscripciones Suscripcion[]

  /// SISTEMA 2026: Suscripción familiar (un PreApproval por familia)
  suscripcionFamiliar SuscripcionFamiliar?

  /// SISTEMA 2026: Pagos de cursos temporales
  pagosCurso PagoCurso[]

  /// Vista unificada: todas las inscripciones de los hijos del tutor
  inscripcionesUnificadas InscripcionUnificada[] @relation("InscripcionUnificadaTutor")

  /// Vista unificada: historial de facturación/pagos del tutor
  facturacionUnificada FacturacionUnificada[] @relation("FacturacionUnificadaTutor")

  /// NOTIFICACIONES: Notificaciones del tutor
  notificaciones Notificacion[]

  @@map("tutores")
}

/// Modelo para estudiantes asociados a un tutor
/// Representa a los alumnos que utilizarán la plataforma
model Estudiante {
  /// Identificador único del estudiante
  id                String    @id @default(cuid())
  /// Username único del estudiante - usado para autenticación (OBLIGATORIO)
  username          String    @unique
  /// Nombre del estudiante
  nombre            String
  /// Apellido del estudiante
  apellido          String
  /// Nivel escolar del estudiante: Primaria, Secundaria, Universidad
  nivelEscolar      String    @map("nivel_escolar")
  /// URL del avatar 3D de Ready Player Me
  /// Ejemplo: https://models.readyplayer.me/abc123.glb
  avatarUrl         String?   @map("avatar_url") @db.Text
  /// URL de la animación idle seleccionada por el estudiante
  /// Ejemplo: https://bx0qberriuipqy7z.public.blob.vercel-storage.com/animations/masculine/idle/M_Standing_Idle_001.glb
  animacionIdleUrl  String?   @map("animacion_idle_url") @db.Text
  /// DEPRECADO: URL de la foto de perfil del estudiante (mantener por compatibilidad)
  fotoUrl           String?   @map("foto_url")
  /// ID del tutor que gestiona este estudiante
  tutorId           String    @map("tutor_id")
  /// ID de la casa a la que pertenece el estudiante (sistema 2026)
  casaId            String?   @map("casa_id")
  /// Nivel actual del estudiante en el sistema de gamificación
  /// NOTA: puntos_totales fue migrado a RecursosEstudiante.xp_total (SUB-FASE 1.3)
  nivelActual       Int       @default(1) @map("nivel_actual")
  /// Timestamp de creación del registro
  createdAt         DateTime  @default(now())
  /// Timestamp de última actualización del registro
  updatedAt         DateTime  @updatedAt
  /// ID del gradiente del avatar (0-9)
  /// Corresponde a uno de los 10 gradientes predefinidos del sistema
  avatarGradient    Int       @default(0) @map("avatar_gradient")
  /// Edad del estudiante en años
  edad              Int
  /// Email único del estudiante - usado para autenticación propia
  /// IMPORTANTE: Debe estar indexado para búsquedas rápidas en login
  email             String?   @unique
  /// Hash bcrypt de la contraseña - NUNCA se envía al frontend
  /// Permite que el estudiante acceda al portal con sus propias credenciales
  passwordHash      String?   @map("password_hash")
  /// Fecha del último cambio de contraseña
  fechaUltimoCambio DateTime? @map("fecha_ultimo_cambio")
  /// Roles asignados al estudiante (normalmente solo ["estudiante"])
  /// Ejemplo: ["estudiante"]
  roles             Json      @default("[\"estudiante\"]")
  /// DEPRECADO: ID del sector al que pertenece el estudiante (usar sectores[] en su lugar)
  /// Mantener temporalmente para migración gradual
  sectorId          String?   @map("sector_id")

  // === PLAN DE SUSCRIPCIÓN DIRECTO (2026) ===
  /// ID del plan asignado directamente al estudiante
  /// Si es null, se hereda del tutor (comportamiento legacy)
  /// Permite asignar planes diferentes a cada hijo del mismo tutor
  planId               String?                @map("plan_id")
  /// Estado del acceso del estudiante (independiente del pago)
  /// Permite becas, suspensiones temporales, etc.
  estadoAcceso         EstadoAccesoEstudiante @default(ACTIVO) @map("estado_acceso")
  /// Fecha de vencimiento del plan (para becas temporales, promociones)
  /// Si es null, el plan no vence
  fechaVencimientoPlan DateTime?              @map("fecha_vencimiento_plan")
  /// Notas administrativas sobre el plan (ej: "Beca olimpiada 2026")
  notasPlan            String?                @map("notas_plan")

  // === SISTEMA DE ACCESO FLEXIBLE (2026) ===
  /// Override manual de acceso (admin puede dar acceso temporal sin plan/comisión)
  accesoOverride       Boolean   @default(false) @map("acceso_override")
  /// Fecha hasta la cual el override es válido (null = indefinido)
  accesoOverrideHasta  DateTime? @map("acceso_override_hasta")
  /// Motivo del override (ej: "Prueba gratuita", "Cortesía evento")
  accesoOverrideMotivo String?   @map("acceso_override_motivo")

  // Relación con PlanSuscripcion
  plan PlanSuscripcion? @relation(fields: [planId], references: [id])

  alertas                 Alerta[]
  asistencias             Asistencia[]
  casa                    Casa?                   @relation(fields: [casaId], references: [id])
  sector                  Sector?                 @relation("EstudianteSectorLegacy", fields: [sectorId], references: [id])
  // TODO [CRIT-005]: Cambiar onDelete: Cascade a onDelete: Restrict
  // Borrar un tutor no debería eliminar automáticamente sus estudiantes
  // Ver: /docs/TODO_PRE_LAUNCH.md
  tutor                   Tutor                   @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  inscripcionesClase      InscripcionClase[]
  inscripcionesClaseGrupo InscripcionClaseGrupo[]
  asistenciasClaseGrupo   AsistenciaClaseGrupo[]
  puntosObtenidos         PuntoObtenido[]
  inscripcionesMensuales  InscripcionMensual[]
  recursos                RecursosEstudiante?

  /// GAMIFICACIÓN V2
  logrosDesbloqueados LogroEstudiante[]
  racha               RachaEstudiante?

  /// COLONIA DE VERANO
  coloniaInscripciones ColoniaEstudiante[]

  /// SANDBOX: Progreso en contenidos educativos
  progresosContenido ProgresoContenido[]

  /// Inscripciones a comisiones de productos (Colonias, Talleres, etc.)
  inscripcionesComision InscripcionComision[]

  /// LIVEKIT: Registros de asistencia en clases en vivo
  asistenciasLive AsistenciaLive[]

  /// PLANIFICACIONES v2: Progreso del estudiante en clases y tareas
  progresosClase ProgresoClaseEstudiante[]
  progresosTarea ProgresoTareaEstudiante[]

  /// COMISIONES: Registros de asistencia en comisiones (talleres, colonias)
  asistenciasComision AsistenciaComision[]

  /// Observaciones recibidas de docentes
  observaciones ObservacionEstudiante[]

  /// SISTEMA ACCESO: Historial de cambios de acceso del estudiante
  historialAcceso HistorialAccesoEstudiante[]

  /// ACTIVITY FEED: Actividades del estudiante en el feed social
  actividadesFeed ActividadFeed[]
  /// ACTIVITY FEED: Reacciones del estudiante a actividades de otros
  reaccionesFeed  ReaccionFeed[]

  /// SISTEMA 2026: Inscripciones de actividades
  inscripcionesActividad InscripcionActividad[]
  /// SISTEMA 2026: Pagos de cursos temporales
  pagosCurso             PagoCurso[]

  /// VERANO 2026: Decisiones de verano (una por año)
  decisionesVerano DecisionVeranoEstudiante[]

  /// Vista unificada: todas las inscripciones (manual + suscripción)
  inscripcionesUnificadas InscripcionUnificada[] @relation("InscripcionUnificadaEstudiante")

  /// Vista unificada: historial de facturación/pagos del estudiante (para pagos manuales)
  facturacionUnificada FacturacionUnificada[] @relation("FacturacionUnificadaEstudiante")

  /// NOTIFICACIONES: Notificaciones del estudiante
  notificaciones Notificacion[]

  // Índices de performance para rankings y listados
  // NOTA: Índices de puntos_totales eliminados - usar RecursosEstudiante para rankings (SUB-FASE 1.3)
  @@index([tutorId, apellido], name: "idx_estudiantes_tutor_listado")
  @@map("estudiantes")
}

/// Historial de cambios de acceso de un estudiante
/// Registra todas las modificaciones de acceso para auditoría y trazabilidad
model HistorialAccesoEstudiante {
  /// Identificador único del registro
  id           String   @id @default(cuid())
  /// ID del estudiante al que pertenece este registro
  estudianteId String   @map("estudiante_id")
  /// Fecha y hora del cambio
  fecha        DateTime @default(now())

  /// Acción realizada (ej: "PLAN_ASIGNADO", "COMISION_INSCRIPCION", "OVERRIDE_ACTIVADO", "ACCESO_REVOCADO")
  accion   String
  /// Origen del acceso (ej: "PLAN_DIRECTO", "SUSCRIPCION_TUTOR", "COMISION", "OVERRIDE")
  origen   String
  /// ID del recurso origen (plan_id, suscripcion_id, comision_id, etc.)
  origenId String? @map("origen_id")

  /// Estado anterior del acceso (JSON con permisos anteriores)
  estadoAnterior Json?   @map("estado_anterior")
  /// Estado nuevo del acceso (JSON con permisos nuevos)
  estadoNuevo    Json?   @map("estado_nuevo")
  /// ID del usuario que ejecutó el cambio (admin, sistema, etc.)
  ejecutadoPor   String? @map("ejecutado_por")

  /// Metadata adicional (motivo, notas, contexto)
  metadata Json?

  /// Relación con Estudiante
  estudiante Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)

  @@index([estudianteId, fecha])
  @@index([accion, fecha])
  @@map("historial_acceso_estudiante")
}

/// Modelo para casas del sistema 2026
/// Las casas agrupan estudiantes por rango de edad con colores y gamificación propios
/// Reemplaza el modelo Equipo anterior
model Casa {
  /// Identificador único de la casa
  id     String   @id @default(cuid())
  /// Tipo de casa (QUANTUM, VERTEX, PULSAR) - único
  tipo   CasaTipo @unique
  /// Nombre de la casa para mostrar
  nombre String   @unique
  /// Emoji representativo de la casa
  emoji  String
  /// Slogan o lema de la casa
  slogan String?

  /// Edad mínima para pertenecer a esta casa
  edadMinima Int @map("edad_minima")
  /// Edad máxima para pertenecer a esta casa
  edadMaxima Int @map("edad_maxima")

  /// Color primario en formato hexadecimal (Design System 2026)
  colorPrimary   String @map("color_primary")
  /// Color secundario en formato hexadecimal
  colorSecondary String @map("color_secondary")
  /// Color de acento en formato hexadecimal
  colorAccent    String @map("color_accent")
  /// Color oscuro en formato hexadecimal
  colorDark      String @map("color_dark")
  /// Gradiente CSS para backgrounds
  gradiente      String

  /// Puntos totales acumulados por todos los estudiantes de la casa
  puntosTotales Int @default(0) @map("puntos_totales")

  /// Timestamp de creación del registro
  createdAt DateTime @default(now())
  /// Timestamp de última actualización del registro
  updatedAt DateTime @updatedAt

  /// Estudiantes que pertenecen a esta casa
  estudiantes Estudiante[]

  /// Comisiones asignadas a esta casa
  comisiones Comision[]

  /// Actividades del feed de esta casa
  actividadesFeed ActividadFeed[]

  @@map("casas")
}

/// Modelo para Mundos STEAM (2026)
/// Representa las 3 áreas de conocimiento: Matemática, Programación, Ciencias
model Mundo {
  /// Identificador único del mundo
  id          String    @id @default(cuid())
  /// Tipo de mundo (MATEMATICA, PROGRAMACION, CIENCIAS) - único
  tipo        MundoTipo @unique
  /// Nombre del mundo para mostrar
  nombre      String    @unique
  /// Descripción del mundo
  descripcion String?
  /// Icono del mundo (emoji o nombre de icono)
  icono       String

  /// Color primario en formato hexadecimal
  colorPrimary   String @map("color_primary")
  /// Color secundario en formato hexadecimal
  colorSecondary String @map("color_secondary")
  /// Color de acento en formato hexadecimal
  colorAccent    String @map("color_accent")
  /// Gradiente CSS para backgrounds
  gradiente      String

  /// Indica si el mundo está activo
  activo Boolean @default(true)
  /// Orden de visualización
  orden  Int     @default(0)

  /// Timestamp de creación del registro
  createdAt DateTime @default(now())
  /// Timestamp de última actualización del registro
  updatedAt DateTime @updatedAt

  // Índice de performance para filtros de mundos activos
  @@index([activo], name: "idx_mundos_activo")
  @@map("mundos")
}

// ============================================================================
// SISTEMA DE CONTENIDO EDUCATIVO (SANDBOX)
// ============================================================================

/// Contenido educativo (lección) creada en el Sandbox
/// Una lección completa con múltiples slides para estudiantes
model Contenido {
  /// Identificador único del contenido
  id String @id @default(cuid())

  /// Título de la lección
  titulo String

  /// Casa objetivo (QUANTUM, VERTEX, PULSAR)
  /// Define qué estudiantes pueden ver este contenido
  casaTipo CasaTipo @map("casa_tipo")

  /// Mundo/materia (MATEMATICA, PROGRAMACION, CIENCIAS)
  mundoTipo MundoTipo @map("mundo_tipo")

  /// Estado actual del contenido
  estado EstadoContenido @default(BORRADOR)

  /// Tipo de contenido educativo
  tipo TipoContenido @default(MICROLECCION)

  /// ID del admin que creó el contenido
  creadorId String? @map("creador_id")

  /// Descripción o resumen (opcional)
  descripcion String?

  /// URL de imagen de portada (opcional)
  imagenPortada String? @map("imagen_portada")

  /// Orden de visualización dentro de la casa/mundo
  orden Int @default(0)

  /// Duración estimada en minutos
  duracionMinutos Int? @map("duracion_minutos")

  /// Para JUEGO/SIMULACION: ID del componente React/Phaser
  juegoCodigo String? @map("juego_codigo")

  /// Fecha de publicación (null si es borrador)
  fechaPublicacion DateTime? @map("fecha_publicacion")

  /// Timestamp de creación del registro
  createdAt DateTime @default(now())

  /// Timestamp de última actualización del registro
  updatedAt DateTime @updatedAt

  /// Relaciones
  /// onDelete: SetNull permite eliminar Admin sin perder contenidos (quedan huérfanos pero accesibles)
  creador   Admin?              @relation(fields: [creadorId], references: [id], onDelete: SetNull)
  nodos     NodoContenido[]
  progresos ProgresoContenido[]

  /// Relaciones con sistema de Planificaciones
  clasesTeoria   ClasePlanificacion[] @relation("ClaseTeoria")
  clasesPractica ClasePlanificacion[] @relation("ClasePractica")
  tareasClase    TareaClase[]

  @@index([casaTipo, mundoTipo, estado], name: "idx_contenidos_casa_mundo_estado")
  @@index([creadorId], name: "idx_contenidos_creador")
  @@index([estado], name: "idx_contenidos_estado")
  @@index([tipo], name: "idx_contenidos_tipo")
  @@map("contenidos")
}

/// Nodo de contenido jerárquico dentro de un Contenido
/// Permite estructura de árbol: Teoría/Práctica/Evaluación con sub-nodos infinitos
/// Si tiene hijos → es contenedor (carpeta)
/// Si no tiene hijos → es hoja editable (slide con contenidoJson)
model NodoContenido {
  /// Identificador único del nodo
  id String @id @default(cuid())

  /// ID del contenido raíz al que pertenece
  contenidoId String @map("contenido_id")

  /// ID del nodo padre (NULL = nodo raíz: Teoría, Práctica, Evaluación)
  parentId String? @map("parent_id")

  /// Título del nodo
  titulo String

  /// Si es un nodo bloqueado (Teoría, Práctica, Evaluación no se pueden eliminar)
  bloqueado Boolean @default(false)

  /// Orden del nodo dentro de su nivel (hermanos)
  orden Int @default(0)

  /// Contenido JSON (solo si es hoja, es decir, si no tiene hijos)
  /// Se almacena como JSON string que el frontend parsea
  /// NULL si el nodo es contenedor (tiene hijos)
  contenidoJson String? @map("contenido_json") @db.Text

  /// Timestamp de creación del registro
  createdAt DateTime @default(now())

  /// Timestamp de última actualización del registro
  updatedAt DateTime @updatedAt

  /// Relaciones
  contenido Contenido @relation(fields: [contenidoId], references: [id], onDelete: Cascade)

  /// Relación recursiva: nodo padre
  parent NodoContenido? @relation("NodoHijos", fields: [parentId], references: [id], onDelete: Cascade)

  /// Relación recursiva: nodos hijos
  hijos NodoContenido[] @relation("NodoHijos")

  /// Progresos que apuntan a este nodo como nodo actual
  progresosEnNodo ProgresoContenido[]

  @@index([contenidoId], name: "idx_nodos_contenido")
  @@index([parentId], name: "idx_nodos_parent")
  @@index([orden], name: "idx_nodos_orden")
  @@map("nodos_contenido")
}

/// Progreso del estudiante en un contenido
/// Registra el avance y tiempo dedicado a cada lección
model ProgresoContenido {
  /// Identificador único
  id String @id @default(cuid())

  /// ID del estudiante
  estudianteId String @map("estudiante_id")

  /// ID del contenido
  contenidoId String @map("contenido_id")

  /// ID del último nodo visitado (hoja del árbol)
  /// Reemplaza slideActual (índice) por referencia directa al nodo
  nodoActualId String? @map("nodo_actual_id")

  /// Si completó todo el contenido
  completado Boolean @default(false)

  /// Tiempo total dedicado en segundos
  tiempoTotalSegundos Int @default(0) @map("tiempo_total_segundos")

  /// Fecha de inicio
  fechaInicio DateTime @default(now()) @map("fecha_inicio")

  /// Fecha de última actividad
  ultimaActividad DateTime @updatedAt @map("ultima_actividad")

  /// Fecha de completitud (null si no completado)
  fechaCompletitud DateTime? @map("fecha_completitud")

  /// Relaciones
  estudiante Estudiante     @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  contenido  Contenido      @relation(fields: [contenidoId], references: [id], onDelete: Cascade)
  nodoActual NodoContenido? @relation(fields: [nodoActualId], references: [id], onDelete: SetNull)

  @@unique([estudianteId, contenidoId])
  @@index([estudianteId], name: "idx_progreso_estudiante")
  @@index([contenidoId], name: "idx_progreso_contenido")
  @@index([nodoActualId], name: "idx_progreso_nodo_actual")
  @@map("progreso_contenidos")
}

/// Modelo para Tiers de suscripción - Sistema Mateatletas 2026
///
/// Sistema de 3 tiers STEAM:
/// - STEAM_LIBROS: $40k - Plataforma completa (todos los mundos)
/// - STEAM_ASINCRONICO: $65k - Todo + clases grabadas
/// - STEAM_SINCRONICO: $95k - Todo + clases en vivo con docente
///
/// Reglas de negocio:
/// - El tier es por estudiante, no por familia
/// - Descuento 10% para 2do hermano en adelante
/// - Todos los tiers tienen acceso a libros
model Tier {
  /// Identificador único del tier
  id            String     @id @default(cuid())
  /// Nombre del tier (STEAM_LIBROS, STEAM_ASINCRONICO, STEAM_SINCRONICO)
  nombre        TierNombre @unique
  /// Precio mensual en pesos
  precioMensual Int        @map("precio_mensual")
  /// Cantidad de mundos async incluidos
  mundosAsync   Int        @map("mundos_async")
  /// Cantidad de mundos sync (con docente) incluidos
  mundosSync    Int        @map("mundos_sync")
  /// Indica si incluye acceso a docente
  tieneDocente  Boolean    @default(false) @map("tiene_docente")
  /// Descripción del tier para UI
  descripcion   String?
  /// Indica si el tier está activo para nuevas inscripciones
  activo        Boolean    @default(true)
  /// Orden de visualización (para pricing page)
  orden         Int        @default(0)

  /// Timestamp de creación del registro
  createdAt DateTime @default(now())
  /// Timestamp de última actualización del registro
  updatedAt DateTime @updatedAt

  @@map("tiers")
}

/// Modelo para docentes (profesores) de la plataforma
/// Representa a los usuarios educadores que dictan clases
model Docente {
  /// Identificador único del docente
  id                    String          @id @default(cuid())
  /// Email único del docente - usado para autenticación
  email                 String          @unique
  /// Hash bcrypt de la contraseña
  passwordHash          String          @map("password_hash")
  /// Nombre del docente
  nombre                String
  /// Apellido del docente
  apellido              String
  /// Título profesional (ej: "Profesor de Matemática", "Licenciado en Física")
  titulo                String?
  /// Biografía o descripción del docente
  bio                   String?
  /// Timestamp de creación del registro
  createdAt             DateTime        @default(now())
  /// Timestamp de última actualización del registro
  updatedAt             DateTime        @updatedAt
  /// Disponibilidad horaria del docente (ej: {"lunes": ["09:00-12:00", "14:00-18:00"], "martes": ["10:00-13:00"]})
  /// Se almacena como JSON object con días de la semana como keys
  disponibilidadHoraria Json?           @map("disponibilidad_horaria")
  /// Especialidades del docente (ej: ["Álgebra", "Geometría", "Trigonometría"])
  /// Se almacena como JSON array de strings
  especialidades        Json?
  /// Estado del docente (activo, inactivo, vacaciones)
  estado                String          @default("activo")
  /// Años de experiencia docente
  experienciaAnos       Int?            @map("experiencia_anos")
  /// Nivel educativo que el docente puede impartir (ej: ["Primaria", "Secundaria", "Universidad"])
  /// Se almacena como JSON array de strings
  nivelEducativo        Json?           @map("nivel_educativo")
  /// Roles asignados al docente (puede ser docente y admin simultáneamente)
  /// Ejemplo: ["docente", "admin"]
  roles                 Json            @default("[\"docente\"]")
  /// Teléfono de contacto (opcional)
  telefono              String?
  /// Fecha del último cambio de contraseña
  fechaUltimoCambio     DateTime?       @map("fecha_ultimo_cambio")
  /// Indica si el docente debe cambiar su contraseña en el próximo login
  /// Se establece en true al crear el docente o cuando un admin resetea su contraseña
  mustChangePassword    Boolean         @default(true) @map("must_change_password")
  clases                Clase[]
  claseGrupos           ClaseGrupo[]
  rutasEspecialidad     DocenteRuta[]
  eventos               Evento[]
  notificaciones        Notificacion[]
  puntosOtorgados       PuntoObtenido[] @relation("PuntosOtorgados")
  /// Comisiones a cargo de este docente
  comisiones            Comision[]
  /// Anuncios publicados por este docente
  anuncios              Anuncio[]

  /// Asignaciones de planificaciones a grupos
  asignacionesPlanificacion AsignacionPlanificacion[]

  /// Observaciones creadas por este docente
  observaciones Observacion[]

  /// Sistema Casa/Mundo 2026: Casas asignadas al docente
  casas DocenteCasa[]

  /// Sistema Casa/Mundo 2026: Mundos asignados al docente
  mundos DocenteMundo[]

  /// Sistema Casa/Mundo 2026: Tipo de asignación del docente
  tipoAsignacion TipoAsignacionDocente @default(CLASE_GRUPOS) @map("tipo_asignacion")

  @@map("docentes")
}

/// Asignación de docente a una Casa (QUANTUM, VERTEX, PULSAR)
/// Permite que admin asigne docentes a casas específicas
model DocenteCasa {
  /// Identificador único
  id String @id @default(cuid())

  /// ID del docente
  docenteId String @map("docente_id")

  /// Tipo de casa asignada
  casaTipo CasaTipo @map("casa_tipo")

  /// Fecha de asignación
  asignadoEn DateTime @default(now()) @map("asignado_en")

  /// Relaciones
  docente Docente @relation(fields: [docenteId], references: [id], onDelete: Cascade)

  @@unique([docenteId, casaTipo])
  @@index([docenteId])
  @@index([casaTipo])
  @@map("docentes_casas")
}

/// Asignación de docente a un Mundo (MATEMATICA, PROGRAMACION, CIENCIAS)
/// Permite que admin asigne docentes a mundos específicos
model DocenteMundo {
  /// Identificador único
  id String @id @default(cuid())

  /// ID del docente
  docenteId String @map("docente_id")

  /// Tipo de mundo asignado
  mundoTipo MundoTipo @map("mundo_tipo")

  /// Fecha de asignación
  asignadoEn DateTime @default(now()) @map("asignado_en")

  /// Relaciones
  docente Docente @relation(fields: [docenteId], references: [id], onDelete: Cascade)

  @@unique([docenteId, mundoTipo])
  @@index([docenteId])
  @@index([mundoTipo])
  @@map("docentes_mundos")
}

/// Modelo para administradores del sistema
/// Tienen acceso completo al dashboard administrativo
model Admin {
  /// Identificador único del admin (CUID)
  id                String    @id @default(cuid())
  /// Email único del admin - usado para autenticación
  email             String    @unique
  /// Hash bcrypt de la contraseña - NUNCA se envía al frontend
  passwordHash      String    @map("password_hash")
  /// Fecha del último cambio de contraseña
  fechaUltimoCambio DateTime? @map("fecha_ultimo_cambio")
  /// Nombre del admin
  nombre            String
  /// Apellido del admin
  apellido          String
  /// Fecha en que el admin fue creado
  fechaRegistro     DateTime  @default(now()) @map("fecha_registro")
  /// Timestamp de creación del registro
  createdAt         DateTime  @default(now())
  /// Timestamp de última actualización del registro
  updatedAt         DateTime  @updatedAt
  /// DNI del admin (opcional)
  dni               String?
  /// Roles asignados al admin (puede ser admin y docente simultáneamente)
  /// Ejemplo: ["admin", "docente"]
  roles             Json      @default("[\"admin\"]")
  /// Teléfono del admin (opcional)
  telefono          String?
  /// Secret TOTP para MFA (Multi-Factor Authentication)
  /// Guardado encriptado en DB para seguridad
  mfaSecret         String?   @map("mfa_secret")
  /// Indica si MFA está habilitado para este admin
  mfaEnabled        Boolean   @default(false) @map("mfa_enabled")
  /// Códigos de backup para MFA (hasheados con bcrypt)
  /// Array de strings - cada código es de un solo uso
  mfaBackupCodes    String[]  @default([]) @map("mfa_backup_codes")

  /// SANDBOX: Contenidos educativos creados por este admin
  contenidosCreados Contenido[]

  /// NOTIFICACIONES: Notificaciones del admin
  notificaciones Notificacion[]

  @@map("admins")
}

/// Registro de intentos de login para seguridad y rate limiting
/// Almacena tanto intentos exitosos como fallidos para auditoría
model LoginAttempt {
  /// Identificador único del intento
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Email usado en el intento de login
  email     String   @db.VarChar(255)
  /// Dirección IP desde donde se hizo el intento
  ip        String   @db.VarChar(45)
  /// Si el intento fue exitoso o no
  success   Boolean  @default(false)
  /// Timestamp del intento
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([email], name: "idx_login_attempts_email")
  @@index([createdAt], name: "idx_login_attempts_created_at")
  @@map("login_attempts")
}

/// Token para recuperación de contraseña (olvidé mi contraseña)
/// Los tokens son de un solo uso y expiran en 1 hora
model PasswordResetToken {
  /// Identificador único del token
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Email del usuario que solicita el reset
  email     String   @db.VarChar(255)
  /// Token hasheado (SHA256) - nunca almacenar en texto plano
  token     String   @db.VarChar(64)
  /// Tipo de usuario (tutor, docente, admin, estudiante)
  userType  String   @map("user_type") @db.VarChar(20)
  /// Timestamp de expiración (1 hora desde creación)
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  /// Si el token ya fue usado
  used      Boolean  @default(false)
  /// Timestamp de creación
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([email], name: "idx_password_reset_email")
  @@index([token], name: "idx_password_reset_token")
  @@index([expiresAt], name: "idx_password_reset_expires")
  @@map("password_reset_tokens")
}

/// Sesiones activas de refresh tokens (para gestión de sesiones)
/// Permite ver y revocar sesiones desde cualquier dispositivo
model RefreshTokenSession {
  /// Identificador único (JTI del refresh token)
  id            String   @id @db.VarChar(36)
  /// ID del usuario (CUID - compatible con Tutor, Docente, Admin, Estudiante)
  userId        String   @map("user_id") @db.VarChar(30)
  /// Tipo de usuario (tutor, docente, admin, estudiante)
  userType      String   @map("user_type") @db.VarChar(20)
  /// Dirección IP desde donde se creó la sesión
  ipAddress     String?  @map("ip_address") @db.VarChar(45)
  /// User agent del navegador/app
  userAgent     String?  @map("user_agent") @db.VarChar(500)
  /// Timestamp de creación de la sesión
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  /// Timestamp de última actividad (renovación de token)
  lastUsedAt    DateTime @default(now()) @map("last_used_at") @db.Timestamptz
  /// Timestamp de expiración
  expiresAt     DateTime @map("expires_at") @db.Timestamptz
  /// Si la sesión fue revocada manualmente
  revoked       Boolean  @default(false)
  /// Razón de revocación (logout, password_change, security, admin_action)
  revokedReason String?  @map("revoked_reason") @db.VarChar(50)

  @@index([userId], name: "idx_refresh_session_user")
  @@index([expiresAt], name: "idx_refresh_session_expires")
  @@map("refresh_token_sessions")
}

/// Modelo para productos del catálogo
/// Representa los productos que se pueden comprar: suscripciones, cursos, recursos
/// Sistema 2026: Productos tipo Club con segmentación Casa/Mundo
model Producto {
  /// Identificador único del producto
  id            String       @id @default(cuid())
  /// Nombre del producto (ej: "Club Matemática Olímpica - Ñandú N1")
  nombre        String
  /// Descripción detallada del producto
  descripcion   String?
  /// Precio del producto en pesos (formato decimal para precisión)
  /// Para tipo Club: ignorado (el precio lo define el Tier)
  precio        Decimal      @db.Decimal(10, 2)
  /// Tipo de producto (Club, Evento, Digital, Fisico, Curso, etc.)
  tipo          TipoProducto
  /// Subcategoría del producto (opcional, para agrupar por tipo)
  subcategoria  String?
  /// URL de imagen de portada del producto (opcional)
  imagenPortada String?      @map("imagen_portada")
  /// Indica si el producto está activo y disponible para compra
  activo        Boolean      @default(true)

  // === SEGMENTACIÓN CASA/MUNDO (Sistema 2026) ===

  /// Casa a la que pertenece el producto (QUANTUM, VERTEX, PULSAR)
  casa           CasaTipo?
  /// Mundo al que pertenece el producto (MATEMATICA, PROGRAMACION, CIENCIAS)
  mundo          MundoTipo?
  /// Subtipo de mundo (solo para Matemática: GENERAL u OLIMPICA)
  subtipoMundo   SubtipoMundo?   @map("subtipo_mundo")
  /// Nivel de olimpiadas (solo si subtipo_mundo = OLIMPICA)
  nivelOlimpiada NivelOlimpiada? @map("nivel_olimpiada")

  // === RESTRICCIONES DE EDAD ===

  /// Edad mínima para inscribirse
  edadMinima         Int?    @map("edad_minima")
  /// Edad máxima para inscribirse
  edadMaxima         Int?    @map("edad_maxima")
  /// Permite excepciones por altas capacidades
  permiteExcepciones Boolean @default(false) @map("permite_excepciones")

  // === VISIBILIDAD ===

  /// Visible en la landing page pública
  visibleEnLanding Boolean @default(true) @map("visible_en_landing")
  /// Orden de display en listados (menor = primero)
  ordenDisplay     Int     @default(0) @map("orden_display")

  // === CAMPOS EXISTENTES (cursos temporales) ===

  /// Fecha de inicio del curso (solo para tipo Curso/Evento)
  fechaInicio   DateTime? @map("fecha_inicio")
  /// Fecha de finalización del curso (solo para tipo Curso/Evento)
  fechaFin      DateTime? @map("fecha_fin")
  /// Cupo máximo de estudiantes (solo para tipo Curso/Evento)
  cupoMaximo    Int?      @map("cupo_maximo")
  /// Duración en meses de la suscripción (1=mensual, 12=anual, etc.)
  duracionMeses Int?      @default(1) @map("duracion_meses")
  /// Precio con descuento por pago de contado (1 solo pago)
  precioContado Decimal?  @map("precio_contado") @db.Decimal(10, 2)
  /// Indica si el producto permite pago en cuotas via MercadoPago
  permiteCuotas Boolean   @default(false) @map("permite_cuotas")
  /// Máximo de cuotas permitidas (3, 6, 12, etc.)
  maxCuotas     Int?      @map("max_cuotas")

  // === TIMESTAMPS ===

  /// Timestamp de creación del registro
  createdAt DateTime @default(now())
  /// Timestamp de última actualización del registro
  updatedAt DateTime @updatedAt

  // === PLANIFICACIÓN (Solo para tipo Club) ===

  /// Planificación asignada a nivel producto (aplica a todos sus ClaseGrupos)
  planificacionId String?        @map("planificacion_id")
  planificacion   Planificacion? @relation(fields: [planificacionId], references: [id])

  // === RELACIONES ===

  clases                 Clase[]
  inscripcionesMensuales InscripcionMensual[]
  /// Comisiones (turnos/horarios) de este producto
  comisiones             Comision[]
  /// ClaseGrupos (horarios de Club) de este producto
  claseGrupos            ClaseGrupo[]
  /// Inscripciones de actividad a este producto
  inscripcionesActividad InscripcionActividad[]
  /// Pagos de cursos temporales
  pagosCurso             PagoCurso[]

  @@index([tipo, activo])
  @@index([casa, mundo])
  @@index([visibleEnLanding, activo])
  @@index([planificacionId])
  @@map("productos")
}

// [ELIMINADO] Membresia e InscripcionCurso - sistema legacy reemplazado por Suscripciones PreApproval

/// Modelo para clases programadas
/// Representa una clase en vivo programada por un admin
model Clase {
  /// Identificador único de la clase
  id              String             @id @default(cuid())
  /// ID del docente asignado a la clase
  docenteId       String             @map("docente_id")
  /// Fecha y hora de inicio de la clase
  fechaHoraInicio DateTime           @map("fecha_hora_inicio")
  /// Duración de la clase en minutos
  duracionMinutos Int                @map("duracion_minutos")
  /// Estado de la clase (Programada, Cancelada)
  estado          EstadoClase        @default(Programada)
  /// Cupo máximo de estudiantes
  cuposMaximo     Int                @map("cupos_maximo")
  /// Cupos ocupados actualmente
  cuposOcupados   Int                @default(0) @map("cupos_ocupados")
  /// ID del producto curso (opcional - si null es clase de suscripción general)
  /// Si tiene valor, solo estudiantes con InscripcionCurso activa pueden reservar
  productoId      String?            @map("producto_id")
  /// Timestamp de creación del registro
  createdAt       DateTime           @default(now())
  /// Timestamp de última actualización del registro
  updatedAt       DateTime           @updatedAt
  /// Descripción o grupo de la clase (ej: "Niños 6-7 años", "Grupo A", "Preparación olimpiadas")
  descripcion     String?
  /// Nombre o tema de la clase (ej: "Godot", "Scratch", "Preparación Olimpiadas")
  nombre          String
  /// ID del sector (Matemática o Programación) - OPCIONAL
  sectorId        String?            @map("sector_id")
  alertas         Alerta[]
  asistencias     Asistencia[]
  docente         Docente            @relation(fields: [docenteId], references: [id])
  producto        Producto?          @relation(fields: [productoId], references: [id])
  sector          Sector?            @relation(fields: [sectorId], references: [id])
  eventos         Evento[]
  inscripciones   InscripcionClase[]
  puntosObtenidos PuntoObtenido[]

  @@index([docenteId])
  @@index([fechaHoraInicio])
  @@index([estado])
  @@index([productoId])
  @@map("clases")
}

/// Modelo para Grupos Pedagógicos (Sistema Casa/Mundo 2026)
/// Representa los niveles educativos o categorías pedagógicas (B1, B2, B3, A1, etc.)
/// Los grupos son conceptos estables que agrupan contenido pedagógico del mismo nivel
/// Cada grupo pertenece a una Casa (por edad) y un Mundo (por disciplina)
model GrupoPedagogico {
  /// Identificador único del grupo
  id String @id @default(cuid())

  /// Código del grupo (ej: "B1", "B2", "B3", "A1", "OLIMP")
  codigo String @unique

  /// Nombre descriptivo del grupo
  nombre String // "Básico 1", "Básico 2", "Avanzado 1"

  /// Descripción del grupo y nivel educativo
  descripcion String?

  /// Rango de edad sugerido
  edadMinima Int? @map("edad_minima")
  edadMaxima Int? @map("edad_maxima")

  /// Sistema Casa/Mundo 2026: Casa a la que pertenece (QUANTUM, VERTEX, PULSAR)
  casaTipo CasaTipo? @map("casa_tipo")

  /// Sistema Casa/Mundo 2026: Mundo al que pertenece (MATEMATICA, PROGRAMACION, CIENCIAS)
  mundoTipo MundoTipo? @map("mundo_tipo")

  /// @deprecated Sector al que pertenece - LEGACY, usar casa_tipo y mundo_tipo
  sectorId String? @map("sector_id")

  /// Link de Google Meet para las clases de este grupo
  linkMeet String? @map("link_meet")

  /// Indica si el grupo está activo
  activo Boolean @default(true)

  /// Timestamp de creación
  createdAt DateTime @default(now())

  /// Timestamp de última actualización
  updatedAt DateTime @updatedAt

  /// Relaciones
  /// @deprecated LEGACY - usar casa_tipo y mundo_tipo
  sector Sector? @relation(fields: [sectorId], references: [id])

  /// ClaseGrupos (instancias de clases sincrónicas semanales)
  claseGrupos ClaseGrupo[]

  /// Comisiones de productos (Colonias, Talleres) vinculadas a este grupo
  comisionesProducto Comision[]

  @@index([codigo])
  @@index([activo])
  @@index([casaTipo])
  @@index([mundoTipo])
  @@map("grupos")
}

/// Modelo para grupos de clases recurrentes (ahora llamado Comision conceptualmente)
/// Representa un grupo estable de estudiantes que se reúne semanalmente
/// Ejemplo: "GRUPO B1 - Matemática - Lunes 19:30"
model ClaseGrupo {
  /// Identificador único del grupo
  id String @id @default(cuid())

  /// Código del grupo pedagógico (puede repetirse, ej: "B2" para varios horarios)
  /// Se usa principalmente para identificación visual, no es unique
  codigo String

  /// Nombre descriptivo del grupo (este sí es único por instancia)
  nombre String @unique

  /// Tipo de clase grupo
  tipo TipoClaseGrupo @default(GRUPO_REGULAR)

  /// Día de la semana en que se reúne
  diaSemana DiaSemana @map("dia_semana")

  /// Hora de inicio en formato HH:MM (ej: "19:30")
  horaInicio String @map("hora_inicio")

  /// Hora de fin en formato HH:MM (ej: "21:00")
  horaFin String @map("hora_fin")

  /// Fecha de inicio de vigencia del grupo
  fechaInicio DateTime @map("fecha_inicio")

  /// Fecha de fin de vigencia del grupo
  /// Para GRUPO_REGULAR: siempre 15 de diciembre del año
  /// Para CURSO_TEMPORAL: fecha específica definida por admin
  fechaFin DateTime @map("fecha_fin")

  /// Año lectivo al que pertenece (ej: 2025)
  anioLectivo Int @map("anio_lectivo")

  /// Cupo máximo de estudiantes
  cupoMaximo Int @default(15) @map("cupo_maximo")

  /// ID del grupo pedagógico al que pertenece (B1, B2, B3, etc.)
  grupoId String @map("grupo_id")

  /// ID del docente asignado
  docenteId String @map("docente_id")

  /// ID del sector (Matemática o Programación)
  sectorId String? @map("sector_id")

  /// ID del producto al que pertenece este horario (Sistema 2026)
  /// Permite vincular ClaseGrupo con Producto tipo Club
  productoId String? @map("producto_id")

  /// Nivel o descripción (ej: "6 y 7 años", "Preparación olimpiadas")
  nivel String?

  /// Indica si el grupo está activo
  activo Boolean @default(true)

  // === LIVEKIT: Campos para clases en vivo ===

  /// Nombre único de la sala en LiveKit (generado automáticamente)
  /// Formato sugerido: "clase_{id}_{timestamp}"
  livekitRoomName String? @unique @map("livekit_room_name")

  /// Estado actual de la clase en vivo
  estadoClase EstadoClase @default(Programada) @map("estado_clase")

  /// Timestamp de cuando el docente inició la clase en vivo
  iniciadaEn DateTime? @map("iniciada_en")

  /// Timestamp de cuando finalizó la clase en vivo
  finalizadaEn DateTime? @map("finalizada_en")

  /// Timestamp de creación
  createdAt DateTime @default(now())

  /// Timestamp de última actualización
  updatedAt DateTime @updatedAt

  /// Relaciones
  grupo    GrupoPedagogico @relation(fields: [grupoId], references: [id])
  docente  Docente         @relation(fields: [docenteId], references: [id])
  sector   Sector?         @relation(fields: [sectorId], references: [id])
  producto Producto?       @relation(fields: [productoId], references: [id])

  /// Estudiantes inscritos en el grupo
  inscripciones InscripcionClaseGrupo[]

  /// Registros de asistencia del grupo
  asistencias AsistenciaClaseGrupo[]

  /// Registros de asistencia en vivo (LiveKit)
  asistenciasLive AsistenciaLive[]

  /// Asignaciones de planificaciones a este grupo
  asignacionesPlanificacion AsignacionPlanificacion[]

  /// Inscripciones de actividad (Sistema 2026)
  inscripcionesActividad InscripcionActividad[]

  /// Vista unificada: todas las inscripciones (manual + suscripción)
  inscripcionesUnificadas InscripcionUnificada[] @relation("InscripcionUnificadaClaseGrupo")

  /// VERANO 2026: Estudiantes asignados a este grupo de Colonia
  asignacionesColoniaVerano DecisionVeranoEstudiante[]

  @@index([docenteId])
  @@index([diaSemana])
  @@index([fechaInicio, fechaFin])
  @@index([anioLectivo])
  @@index([activo])
  @@index([estadoClase])
  @@index([livekitRoomName])
  @@index([productoId])
  @@map("clase_grupos")
}

/// Inscripción de un estudiante a un ClaseGrupo
/// Relación muchos-a-muchos entre Estudiante y ClaseGrupo
///
/// @deprecated Para LECTURA, usar InscripcionUnificada (view)
/// Solo usar esta tabla para ESCRITURA de inscripciones manuales (admin/becas)
/// Las inscripciones via suscripción 2026 se crean en InscripcionActividad
model InscripcionClaseGrupo {
  /// Identificador único
  id String @id @default(cuid())

  /// ID del grupo de clase
  claseGrupoId String @map("clase_grupo_id")

  /// ID del estudiante inscrito
  estudianteId String @map("estudiante_id")

  /// ID del tutor del estudiante
  tutorId String @map("tutor_id")

  /// Fecha de inscripción al grupo
  fechaInscripcion DateTime @default(now()) @map("fecha_inscripcion")

  /// Fecha de baja del grupo (si se retira antes del fin)
  fechaBaja DateTime? @map("fecha_baja")

  /// Observaciones
  observaciones String?

  /// Sistema Casa/Mundo 2026: Tipo de acceso del estudiante
  /// SINCRONICO = participa en vivo, ASINCRONICO = solo grabaciones
  tipoAcceso TipoAccesoInscripcion @default(SINCRONICO) @map("tipo_acceso")

  /// Timestamp de creación
  createdAt DateTime @default(now())

  /// Timestamp de última actualización
  updatedAt DateTime @updatedAt

  /// Relaciones
  claseGrupo ClaseGrupo @relation(fields: [claseGrupoId], references: [id], onDelete: Cascade)
  estudiante Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  tutor      Tutor      @relation(fields: [tutorId], references: [id])

  @@unique([claseGrupoId, estudianteId])
  @@index([estudianteId])
  @@index([tutorId])
  @@index([claseGrupoId])
  @@index([tipoAcceso])
  @@map("inscripciones_clase_grupo")
}

/// Registro de asistencia a una sesión específica de un ClaseGrupo
/// Se crea cuando el docente marca asistencia un día específico
model AsistenciaClaseGrupo {
  /// Identificador único
  id String @id @default(cuid())

  /// ID del grupo de clase
  claseGrupoId String @map("clase_grupo_id")

  /// ID del estudiante
  estudianteId String @map("estudiante_id")

  /// Fecha específica de la clase (ej: "2025-10-21" para el lunes 21/10)
  fecha DateTime

  /// Estado de asistencia
  estado EstadoAsistencia

  /// Observaciones del docente sobre el estudiante en esta clase
  observaciones String?

  /// Calificación o feedback cualitativo (opcional)
  feedback String?

  /// Timestamp de creación
  createdAt DateTime @default(now())

  /// Timestamp de última actualización
  updatedAt DateTime @updatedAt

  /// Relaciones
  claseGrupo ClaseGrupo @relation(fields: [claseGrupoId], references: [id], onDelete: Cascade)
  estudiante Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)

  @@unique([claseGrupoId, estudianteId, fecha])
  @@index([claseGrupoId])
  @@index([estudianteId])
  @@index([fecha])
  // Índice de performance para filtros por estado de asistencia
  @@index([estado], name: "idx_asistencias_estado")
  @@map("asistencias_clase_grupo")
}

/// Registro de asistencia en tiempo real durante clases LiveKit
/// Captura entrada/salida, interacciones y estado del participante
model AsistenciaLive {
  /// Identificador único
  id String @id @default(cuid())

  /// ID del grupo de clase
  claseGrupoId String @map("clase_grupo_id")

  /// ID del estudiante
  estudianteId String @map("estudiante_id")

  /// Timestamp de cuando entró a la sala LiveKit
  entroEn DateTime @default(now()) @map("entro_en")

  /// Timestamp de cuando salió de la sala (null si aún está conectado)
  salioEn DateTime? @map("salio_en")

  /// Duración total en minutos (calculado al salir o periódicamente)
  duracionMinutos Int @default(0) @map("duracion_minutos")

  /// Si el estudiante tiene la mano levantada actualmente
  levantaMano Boolean @default(false) @map("levanta_mano")

  /// Si el estudiante está muteado actualmente
  estaMuteado Boolean @default(false) @map("esta_muteado")

  /// Si el estudiante tiene la cámara encendida
  camaraEncendida Boolean @default(false) @map("camara_encendida")

  /// Si el estudiante está compartiendo pantalla
  compartiendoPantalla Boolean @default(false) @map("compartiendo_pantalla")

  /// Timestamp de creación
  createdAt DateTime @default(now())

  /// Timestamp de última actualización
  updatedAt DateTime @updatedAt

  /// Relaciones
  claseGrupo ClaseGrupo @relation(fields: [claseGrupoId], references: [id], onDelete: Cascade)
  estudiante Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)

  /// Un estudiante solo puede tener un registro activo por clase en vivo
  @@unique([claseGrupoId, estudianteId])
  @@index([claseGrupoId])
  @@index([estudianteId])
  @@index([entroEn])
  @@map("asistencias_live")
}

/// Modelo para inscripciones a clases (reservas)
/// Vincula un estudiante con una clase específica
model InscripcionClase {
  /// Identificador único de la inscripción
  id               String     @id @default(cuid())
  /// ID de la clase
  claseId          String     @map("clase_id")
  /// ID del estudiante inscrito
  estudianteId     String     @map("estudiante_id")
  /// ID del tutor que realizó la reserva
  tutorId          String     @map("tutor_id")
  /// Fecha de la inscripción
  fechaInscripcion DateTime   @default(now()) @map("fecha_inscripcion")
  /// Observaciones o notas sobre la inscripción
  observaciones    String?
  /// Timestamp de creación del registro
  createdAt        DateTime   @default(now())
  /// Timestamp de última actualización del registro
  updatedAt        DateTime   @updatedAt
  clase            Clase      @relation(fields: [claseId], references: [id], onDelete: Cascade)
  estudiante       Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  tutor            Tutor      @relation(fields: [tutorId], references: [id])

  @@unique([claseId, estudianteId])
  @@index([estudianteId])
  @@index([tutorId])
  @@map("inscripciones_clase")
}

/// Modelo para registro de asistencia
/// Registra la asistencia y feedback del docente después de la clase
model Asistencia {
  /// Identificador único del registro de asistencia
  id              String           @id @default(cuid())
  /// ID de la clase
  claseId         String           @map("clase_id")
  /// ID del estudiante
  estudianteId    String           @map("estudiante_id")
  /// Estado de asistencia (Presente, Ausente, Justificado)
  estado          EstadoAsistencia
  /// Observaciones del docente sobre el estudiante en esta clase
  observaciones   String?
  /// Puntos otorgados al estudiante en esta clase (para gamificación)
  puntosOtorgados Int              @default(0) @map("puntos_otorgados")
  /// Fecha y hora del registro de asistencia
  fechaRegistro   DateTime         @default(now()) @map("fecha_registro")
  /// Timestamp de creación del registro
  createdAt       DateTime         @default(now())
  /// Timestamp de última actualización del registro
  updatedAt       DateTime         @updatedAt
  clase           Clase            @relation(fields: [claseId], references: [id], onDelete: Cascade)
  estudiante      Estudiante       @relation(fields: [estudianteId], references: [id], onDelete: Cascade)

  @@unique([claseId, estudianteId])
  @@index([estudianteId])
  @@index([estado])
  @@index([claseId, estudianteId, estado])
  @@map("asistencias")
}

/// Modelo para alertas administrativas generadas desde observaciones de docentes
/// Permite al admin detectar y resolver situaciones que requieren atención
model Alerta {
  /// Identificador único de la alerta
  id           String     @id @default(cuid())
  /// ID del estudiante relacionado con la alerta
  estudianteId String     @map("estudiante_id")
  /// ID de la clase donde se generó la alerta
  claseId      String     @map("clase_id")
  /// Descripción de la alerta (observaciones del docente)
  descripcion  String
  /// Fecha de creación de la alerta
  fecha        DateTime   @default(now())
  /// Indica si la alerta ha sido resuelta
  resuelta     Boolean    @default(false)
  /// Timestamp de creación del registro
  createdAt    DateTime   @default(now())
  /// Timestamp de última actualización del registro
  updatedAt    DateTime   @updatedAt
  clase        Clase      @relation(fields: [claseId], references: [id], onDelete: Cascade)
  estudiante   Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)

  @@index([estudianteId])
  @@index([resuelta])
  @@index([fecha])
  @@map("alertas")
}

/// Modelo para registro de puntos obtenidos (tabla transaccional)
/// Cada registro representa un evento donde un estudiante ganó puntos
model PuntoObtenido {
  /// Identificador único del registro
  id            String     @id @default(cuid())
  /// ID del estudiante que obtuvo los puntos
  estudianteId  String     @map("estudiante_id")
  /// ID del docente que otorgó los puntos
  docenteId     String     @map("docente_id")
  /// Tipo de acción que generó los puntos (reemplaza FK a AccionPuntuable)
  /// Ejemplos: "ASISTENCIA", "PARTICIPACION", "LOGRO", "BONUS"
  tipoAccion    String     @default("ASISTENCIA") @map("tipo_accion")
  /// ID de la clase donde se ganaron los puntos (opcional)
  claseId       String?    @map("clase_id")
  /// Cantidad de puntos otorgados (se guarda para preservar historial)
  puntos        Int
  /// Contexto o razón adicional (opcional)
  contexto      String?
  /// Fecha y hora en que se otorgaron los puntos
  fechaOtorgado DateTime   @default(now()) @map("fecha_otorgado")
  /// Timestamp de creación del registro
  createdAt     DateTime   @default(now())
  /// Timestamp de última actualización del registro
  updatedAt     DateTime   @updatedAt
  clase         Clase?     @relation(fields: [claseId], references: [id])
  docente       Docente    @relation("PuntosOtorgados", fields: [docenteId], references: [id])
  estudiante    Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)

  @@index([estudianteId])
  @@index([docenteId])
  @@index([tipoAccion])
  @@index([fechaOtorgado])
  @@map("puntos_obtenidos")
}

// [ELIMINADO] Modulo, Leccion, ProgresoLeccion - sistema de contenido legacy
// Reemplazado por nuevo sistema: Area → SubArea → Microleccion (FASE 2)

/// Sistema de notificaciones polimórfico
/// Soporta notificaciones para Tutores, Estudiantes, Docentes y Admins
/// IMPORTANTE: Exactamente UNO de los campos *_id debe estar presente (constraint a nivel de app)
model Notificacion {
  /// Identificador único de la notificación
  id        String                @id @default(cuid())
  /// Tipo de notificación (determina destinatario y comportamiento)
  tipo      TipoNotificacion
  /// Título de la notificación (max 100 chars recomendado)
  titulo    String
  /// Mensaje descriptivo de la notificación (max 500 chars recomendado)
  mensaje   String
  /// Indica si la notificación ha sido leída
  leida     Boolean               @default(false)
  /// Prioridad de la notificación (afecta UI y orden)
  prioridad PrioridadNotificacion @default(MEDIA)

  // ═══════════════════════════════════════════════════════════════
  // CAMPOS POLIMÓRFICOS (exactamente uno debe estar presente)
  // ═══════════════════════════════════════════════════════════════

  /// ID del tutor destinatario (null si no es para tutor)
  tutorId      String? @map("tutor_id")
  /// ID del estudiante destinatario (null si no es para estudiante)
  estudianteId String? @map("estudiante_id")
  /// ID del docente destinatario (null si no es para docente)
  docenteId    String? @map("docente_id")
  /// ID del admin destinatario (null si no es para admin)
  adminId      String? @map("admin_id")

  // ═══════════════════════════════════════════════════════════════
  // METADATA Y TIMESTAMPS
  // ═══════════════════════════════════════════════════════════════

  /// Metadata adicional en formato JSON (clase_id, estudiante_id, urls, etc)
  /// Estructura flexible según el tipo de notificación
  metadata  Json?
  /// Timestamp de creación de la notificación
  createdAt DateTime  @default(now())
  /// Fecha de expiración (notificaciones pueden auto-eliminarse)
  expiraEn  DateTime?

  // ═══════════════════════════════════════════════════════════════
  // RELACIONES
  // ═══════════════════════════════════════════════════════════════

  tutor      Tutor?      @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  estudiante Estudiante? @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  docente    Docente?    @relation(fields: [docenteId], references: [id], onDelete: Cascade)
  admin      Admin?      @relation(fields: [adminId], references: [id], onDelete: Cascade)

  // ═══════════════════════════════════════════════════════════════
  // ÍNDICES DE PERFORMANCE
  // ═══════════════════════════════════════════════════════════════

  /// Índice para listar notificaciones no leídas de tutor
  @@index([tutorId, leida])
  @@index([tutorId, createdAt])
  /// Índice para listar notificaciones no leídas de estudiante
  @@index([estudianteId, leida])
  @@index([estudianteId, createdAt])
  /// Índice para listar notificaciones no leídas de docente
  @@index([docenteId, leida])
  @@index([docenteId, createdAt])
  /// Índice para listar notificaciones no leídas de admin
  @@index([adminId, leida])
  @@index([adminId, createdAt])
  /// Índice para cleanup de notificaciones expiradas
  @@index([expiraEn])
  @@map("notificaciones")
}

/// Niveles de prioridad para notificaciones
/// Afecta el orden de visualización y posibles indicadores visuales
enum PrioridadNotificacion {
  /// Información general, puede esperar
  BAJA
  /// Importancia normal
  MEDIA
  /// Requiere atención pronto
  ALTA
  /// Crítica, requiere acción inmediata
  CRITICA

  @@map("prioridad_notificacion")
}

/// Eventos del calendario del docente
/// Modelo base polimórfico: puede ser Clase, Tarea, Recordatorio o Nota
model Evento {
  /// Identificador único del evento
  id           String        @id @default(cuid())
  /// Título del evento
  titulo       String
  /// Descripción detallada del evento
  descripcion  String?
  /// Tipo de evento (CLASE, TAREA, RECORDATORIO, NOTA)
  tipo         TipoEvento
  /// Fecha y hora de inicio del evento
  fechaInicio  DateTime      @map("fecha_inicio")
  /// Fecha y hora de fin del evento
  fechaFin     DateTime      @map("fecha_fin")
  /// Indica si el evento dura todo el día
  esTodoElDia  Boolean       @default(false) @map("es_todo_el_dia")
  /// ID del docente al que pertenece el evento
  docenteId    String        @map("docente_id")
  /// ID de la clase relacionada (para reprogramación/recuperación)
  claseId      String?       @map("clase_id")
  /// Timestamp de creación del evento
  createdAt    DateTime      @default(now())
  /// Timestamp de última actualización del evento
  updatedAt    DateTime      @updatedAt
  clase        Clase?        @relation(fields: [claseId], references: [id])
  docente      Docente       @relation(fields: [docenteId], references: [id], onDelete: Cascade)
  nota         Nota?
  recordatorio Recordatorio?
  tarea        Tarea?

  @@index([docenteId, fechaInicio])
  @@index([tipo])
  @@index([docenteId, tipo])
  @@index([claseId])
  @@map("eventos")
}

/// Tarea administrativa/pedagógica del docente
/// Extensión del modelo Evento para tareas con funcionalidad completa
model Tarea {
  /// Identificador único de la tarea
  id                      String         @id @default(cuid())
  /// ID del evento base asociado
  eventoId                String         @unique @map("evento_id")
  /// Estado actual de la tarea
  estado                  EstadoTarea    @default(PENDIENTE)
  /// Nivel de prioridad de la tarea
  prioridad               PrioridadTarea @default(MEDIA)
  /// Porcentaje de completitud (0-100)
  porcentajeCompletado    Int            @default(0) @map("porcentaje_completado")
  /// Categoría personalizada de la tarea (ej: "Planificación", "Evaluación")
  categoria               String?
  /// Etiquetas para organización (array de strings)
  etiquetas               String[]
  /// Subtareas en formato JSON
  /// Estructura: [{id: string, titulo: string, completada: boolean, orden: number}]
  subtareas               Json           @default("[]")
  /// Archivos adjuntos en formato JSON
  /// Estructura: [{id: string, nombre: string, url: string, tipo: string, tamaño: number}]
  archivos                Json           @default("[]")
  /// ID de clase relacionada (opcional)
  claseRelacionadaId      String?        @map("clase_relacionada_id")
  /// ID de estudiante relacionado (opcional)
  estudianteRelacionadoId String?        @map("estudiante_relacionado_id")
  /// Tiempo estimado para completar en minutos
  tiempoEstimadoMinutos   Int?           @map("tiempo_estimado_minutos")
  /// Tiempo real invertido en minutos
  tiempoRealMinutos       Int?           @map("tiempo_real_minutos")
  /// Configuración de recurrencia en formato JSON
  /// Estructura: {tipo: 'DIARIA'|'SEMANAL'|'MENSUAL', intervalo: number, dias_semana: number[], fecha_fin: string, excepciones: string[]}
  recurrencia             Json?
  /// Recordatorios configurados en formato JSON
  /// Estructura: [{minutos_antes: number, enviado: boolean}]
  recordatorios           Json           @default("[]")
  /// Fecha de completitud
  completedAt             DateTime?
  evento                  Evento         @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  @@index([estado])
  @@index([prioridad])
  @@index([categoria])
  @@map("tareas")
}

/// Recordatorio simple para el docente
/// Extensión del modelo Evento para recordatorios básicos
model Recordatorio {
  /// Identificador único del recordatorio
  id         String  @id @default(cuid())
  /// ID del evento base asociado
  eventoId   String  @unique @map("evento_id")
  /// Indica si el recordatorio fue completado/marcado
  completado Boolean @default(false)
  /// Color personalizado del recordatorio (formato hex)
  color      String  @default("#6366f1")
  evento     Evento  @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  @@map("recordatorios")
}

/// Nota de texto largo para el docente
/// Extensión del modelo Evento para notas/apuntes
model Nota {
  /// Identificador único de la nota
  id        String  @id @default(cuid())
  /// ID del evento base asociado
  eventoId  String  @unique @map("evento_id")
  /// Contenido de la nota (texto largo)
  contenido String
  /// Categoría de la nota (opcional)
  categoria String?
  /// Color personalizado de la nota (formato hex)
  color     String  @default("#8b5cf6")
  evento    Evento  @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  @@index([categoria])
  @@map("notas")
}

/// Modelo para sectores de trabajo (Matemática, Programación, etc.)
/// Permite organizar las especialidades en categorías principales
model Sector {
  /// Identificador único del sector
  id          String             @id @default(cuid())
  /// Nombre del sector (ej: "Matemática", "Programación")
  nombre      String             @unique
  /// Descripción del sector
  descripcion String?
  /// Color hex para UI (ej: "#FF5733")
  color       String             @default("#6366F1")
  /// Icono o emoji para UI (ej: "📐", "💻")
  icono       String             @default("📚")
  /// Indica si el sector está activo
  activo      Boolean            @default(true)
  /// Timestamp de creación del registro
  createdAt   DateTime           @default(now())
  /// Timestamp de última actualización del registro
  updatedAt   DateTime           @updatedAt
  clases      Clase[]
  claseGrupos ClaseGrupo[]
  grupos      GrupoPedagogico[]
  docentes    DocenteRuta[]
  /// Relación uno-a-muchos con estudiantes
  estudiantes Estudiante[]       @relation("EstudianteSectorLegacy")
  rutas       RutaEspecialidad[]

  @@map("sectores")
}

/// Modelo para rutas de especialidad personalizadas dentro de cada sector
/// Ejemplos: "Roblox", "Scratch" (Programación), "Base-Progresivo", "Lógico-Desafiante" (Matemática)
model RutaEspecialidad {
  /// Identificador único de la ruta
  id          String        @id @default(cuid())
  /// Nombre de la ruta (ej: "Roblox", "Base-Progresivo")
  nombre      String
  /// Descripción de la ruta
  descripcion String?
  /// ID del sector al que pertenece
  sectorId    String
  /// Indica si la ruta está activa
  activo      Boolean       @default(true)
  /// Timestamp de creación del registro
  createdAt   DateTime      @default(now())
  /// Timestamp de última actualización del registro
  updatedAt   DateTime      @updatedAt
  docentes    DocenteRuta[]
  sector      Sector        @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@unique([sectorId, nombre])
  @@index([sectorId])
  @@map("rutas_especialidad")
}

/// Modelo de relación muchos-a-muchos entre Docentes y Rutas de Especialidad
/// Un docente puede trabajar en múltiples rutas y sectores
model DocenteRuta {
  /// Identificador único de la relación
  id         String           @id @default(cuid())
  /// ID del docente
  docenteId  String
  /// ID de la ruta de especialidad
  rutaId     String
  /// ID del sector (desnormalizado para queries más rápidas)
  sectorId   String
  /// Fecha de asignación
  asignadoEn DateTime         @default(now())
  docente    Docente          @relation(fields: [docenteId], references: [id], onDelete: Cascade)
  ruta       RutaEspecialidad @relation(fields: [rutaId], references: [id], onDelete: Cascade)
  sector     Sector           @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@unique([docenteId, rutaId])
  @@index([docenteId])
  @@index([rutaId])
  @@index([sectorId])
  @@map("docentes_rutas")
}

/// Enum para tipos de productos disponibles
enum TipoProducto {
  Club // Actividad recurrente todo el año (suscripción mensual)
  Evento // Colonia, talleres, workshops (con fecha y cupo)
  Digital // PDFs, guías, videos descargables
  Fisico // Remeras, libros, merch (con stock)
  Curso // Cursos online con duración
  Servicio // Clase particular, mentoría 1:1
  Bundle // Combo de productos
  Certificacion // Examen + certificado
}

/// Enum para tipos de casa (sistema 2026)
/// Las casas agrupan estudiantes por rango de edad
enum CasaTipo {
  QUANTUM // 6-9 años - Exploradores
  VERTEX // 10-12 años - Constructores
  PULSAR // 13-17 años - Dominadores

  @@map("casa_tipo")
}

/// Enum para tipos de mundo STEAM (2026)
/// Los mundos representan las 3 áreas de conocimiento principales
enum MundoTipo {
  MATEMATICA // Mundo de matemáticas - naranja
  PROGRAMACION // Mundo de programación - verde
  CIENCIAS // Mundo de ciencias - azul

  @@map("mundo_tipo")
}

/// Estado del contenido educativo en el flujo de publicación
/// BORRADOR -> PUBLICADO -> ARCHIVADO
enum EstadoContenido {
  BORRADOR // Creado, editable, no visible para estudiantes
  PUBLICADO // Visible para estudiantes de la casa correspondiente
  ARCHIVADO // Oculto, pero preservado para historial

