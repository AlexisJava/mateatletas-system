/// Estado de inscripción a una comisión
enum EstadoInscripcionComision {
  Pendiente
  Confirmada
  Cancelada
  ListaEspera
}

/// Modelo para comisiones (turnos/grupos) de productos
/// Una Comisión es una instancia operativa de un Producto con horario y cupo específico
/// Ejemplo: Producto "Colonia Verano 2026" → Comisiones: "QUANTUM Mañana", "VERTEX Tarde"
model Comision {
  /// Identificador único de la comisión
  id String @id @default(cuid())

  /// Nombre de la comisión (ej: "Turno Mañana", "QUANTUM Tarde")
  nombre String

  /// Descripción opcional
  descripcion String?

  /// Producto al que pertenece esta comisión
  producto_id String
  producto    Producto @relation(fields: [producto_id], references: [id], onDelete: Cascade)

  /// Casa asignada (opcional - QUANTUM/VERTEX/PULSAR)
  casa_id String?
  casa    Casa?   @relation(fields: [casa_id], references: [id])

  /// Docente a cargo (opcional)
  docente_id String?
  docente    Docente? @relation(fields: [docente_id], references: [id])

  /// Cupo máximo de estudiantes
  cupo_maximo Int?

  /// Horario en texto libre (ej: "Lun-Vie 9:00-12:00")
  horario String?

  /// Fecha de inicio específica de esta comisión (puede diferir del producto)
  fecha_inicio DateTime?

  /// Fecha de fin específica de esta comisión
  fecha_fin DateTime?

  /// Indica si la comisión está activa
  activo Boolean @default(true)

  /// Timestamp de creación
  createdAt DateTime @default(now())

  /// Timestamp de última actualización
  updatedAt DateTime @updatedAt

  /// Inscripciones de estudiantes a esta comisión
  inscripciones InscripcionComision[]

  /// Registros de asistencia en esta comisión
  asistencias AsistenciaComision[]

  /// Observaciones de docentes en esta comisión
  observaciones Observacion[]

  @@index([producto_id])
  @@index([docente_id])
  @@index([casa_id])
  @@index([activo])
  @@map("comisiones")
}

/// Modelo para inscripciones de estudiantes a comisiones
/// Representa la relación entre un Estudiante y una Comisión de un Producto
model InscripcionComision {
  /// Identificador único de la inscripción
  id String @id @default(cuid())

  /// Comisión a la que se inscribe
  comision_id String
  comision    Comision @relation(fields: [comision_id], references: [id], onDelete: Cascade)

  /// Estudiante inscrito
  estudiante_id String
  estudiante    Estudiante @relation(fields: [estudiante_id], references: [id], onDelete: Cascade)

  /// Estado de la inscripción
  estado EstadoInscripcionComision @default(Pendiente)

  /// Fecha de inscripción
  fecha_inscripcion DateTime @default(now())

  /// Notas o comentarios sobre la inscripción
  notas String?

  /// Timestamp de última actualización
  updatedAt DateTime @updatedAt

  /// Un estudiante solo puede estar inscrito una vez por comisión
  @@unique([comision_id, estudiante_id])
  @@index([estudiante_id])
  @@index([estado])
  @@map("inscripciones_comision")
}

/// Modelo para registrar asistencia de estudiantes en comisiones
/// Permite trackear la asistencia por sesión/fecha en cada comisión
model AsistenciaComision {
  /// Identificador único del registro de asistencia
  id String @id @default(cuid())

  /// Comisión donde se registra la asistencia
  comision_id String
  comision    Comision @relation(fields: [comision_id], references: [id], onDelete: Cascade)

  /// Estudiante al que corresponde la asistencia
  estudiante_id String
  estudiante    Estudiante @relation(fields: [estudiante_id], references: [id], onDelete: Cascade)

  /// Fecha de la sesión (solo fecha, sin hora)
  fecha DateTime @db.Date

  /// Estado de asistencia: Presente, Ausente, Justificado
  estado EstadoAsistencia

  /// Observación opcional del docente
  observacion String?

  /// Timestamp de creación
  created_at DateTime @default(now())

  /// Un estudiante solo puede tener un registro de asistencia por comisión y fecha
  @@unique([comision_id, estudiante_id, fecha])
  @@index([comision_id])
  @@index([estudiante_id])
  @@index([fecha])
  @@map("asistencia_comision")
}

