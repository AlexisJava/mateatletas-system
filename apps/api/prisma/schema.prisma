/// Intervalo de cobro para suscripciones
enum IntervaloSuscripcion {
  DIARIO
  SEMANAL
  MENSUAL
  ANUAL
}

/// Estados internos de una suscripción
/// Mapeados desde MercadoPago PreApproval + estados de negocio
enum EstadoSuscripcion {
  PENDIENTE /// Esperando primer pago
  ACTIVA /// Pagos al día, acceso completo
  EN_GRACIA /// Falló cobro, dentro de 3 días de gracia
  MOROSA /// Pasó grace period sin pago, acceso bloqueado
  PAUSADA /// Pausada voluntariamente (máx 30 días)
  CANCELADA /// Cancelada definitivamente
}

/// Estado del acceso de un estudiante a la plataforma
/// Independiente del estado de pago del tutor
enum EstadoAccesoEstudiante {
  ACTIVO /// Acceso normal según su plan
  SUSPENDIDO /// Suspendido temporalmente por admin
  VENCIDO /// Plan venció (fecha_vencimiento_plan pasó)
  BECA /// Acceso por beca (puede tener plan sin pago del tutor)
}

/// Plan de suscripción disponible
/// Define precios y configuración de cobro
model PlanSuscripcion {
  /// Identificador único del plan
  id String @id @default(cuid())

  /// Nombre del plan (STEAM_LIBROS, STEAM_ASINCRONICO, STEAM_SINCRONICO)
  nombre String

  /// Descripción del plan para mostrar al usuario
  descripcion String?

  /// Precio base mensual en pesos argentinos
  precioBase Decimal @map("precio_base") @db.Decimal(10, 2)

  /// Moneda del precio (por defecto ARS)
  moneda String @default("ARS")

  /// Intervalo de cobro (mensual por defecto)
  intervalo IntervaloSuscripcion @default(MENSUAL)

  /// Cantidad de intervalos entre cobros (1 = cada mes)
  intervaloCantidad Int @default(1) @map("intervalo_cantidad")

  /// Si el plan está activo para nuevas suscripciones
  activo Boolean @default(true)

  /// Timestamp de creación
  createdAt DateTime @default(now()) @map("created_at")

  /// Timestamp de última actualización
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Suscripciones asociadas a este plan (pagos de tutores)
  suscripciones Suscripcion[]

  /// Estudiantes con este plan asignado directamente
  estudiantes Estudiante[]

  @@map("planes_suscripcion")
}

/// Suscripción activa de un tutor
/// Vincula un tutor con un plan y gestiona el ciclo de vida
model Suscripcion {
  /// Identificador único de la suscripción
  id String @id @default(cuid())

  /// ID del tutor propietario
  tutorId String @map("tutor_id")

  /// ID del plan de suscripción
  planId String @map("plan_id")

  // === MercadoPago PreApproval ===

  /// ID de la suscripción en MercadoPago (preapproval_id)
  mpPreapprovalId String? @unique @map("mp_preapproval_id")

  /// Estado actual en MercadoPago (pending, authorized, paused, cancelled)
  mpStatus String? @map("mp_status")

  // === Estado interno ===

  /// Estado actual de la suscripción
  estado EstadoSuscripcion @default(PENDIENTE)

  // === Fechas ===

  /// Fecha de inicio de la suscripción (primer pago confirmado)
  fechaInicio DateTime? @map("fecha_inicio")

  /// Fecha del próximo cobro programado
  fechaProximoCobro DateTime? @map("fecha_proximo_cobro")

  /// Fecha de cancelación (si aplica)
  fechaCancelacion DateTime? @map("fecha_cancelacion")

  /// Fecha en que se pausó la suscripción
  fechaPausa DateTime? @map("fecha_pausa")

  /// Fecha en que termina la pausa (máx 30 días después de fecha_pausa)
  fechaFinPausa DateTime? @map("fecha_fin_pausa")

  // === Grace Period ===

  /// Días de gracia usados en el ciclo actual (máx 3)
  diasGraciaUsados Int @default(0) @map("dias_gracia_usados")

  /// Fecha en que inició el período de gracia actual
  fechaInicioGracia DateTime? @map("fecha_inicio_gracia")

  // === Descuento familiar ===

  /// Porcentaje de descuento aplicado (0, 10, 20, etc.)
  descuentoPorcentaje Int @default(0) @map("descuento_porcentaje")

  /// Precio final después de aplicar descuento
  precioFinal Decimal @map("precio_final") @db.Decimal(10, 2)

  // === Auditoría ===

  /// Motivo de cancelación (si fue cancelada)
  motivoCancelacion String? @map("motivo_cancelacion")

  /// Quién canceló: tutor_id, 'system', 'mercadopago'
  canceladoPor String? @map("cancelado_por")

  /// Timestamp de creación
  createdAt DateTime @default(now()) @map("created_at")

  /// Timestamp de última actualización
  updatedAt DateTime @updatedAt @map("updated_at")

  // === Optimistic Locking ===

  /// Versión del registro para control de concurrencia
  version Int @default(0)

  // === Relaciones ===

  /// Tutor propietario de la suscripción
  tutor Tutor @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  /// Plan de suscripción
  plan PlanSuscripcion @relation(fields: [planId], references: [id])

  /// Pagos realizados en esta suscripción
  pagos PagoSuscripcion[]

  /// Historial de cambios de estado
  historial HistorialEstadoSuscripcion[]

  @@index([tutorId])
  @@index([estado])
  @@index([mpPreapprovalId])
  @@map("suscripciones")
}

/// Registro de cada pago de suscripción
/// Guarda el historial de cobros mensuales
model PagoSuscripcion {
  /// Identificador único del pago
  id String @id @default(cuid())

  /// ID de la suscripción a la que pertenece
  suscripcionId String @map("suscripcion_id")

  // === MercadoPago ===

  /// ID del pago en MercadoPago
  mpPaymentId String @unique @map("mp_payment_id")

  /// Estado del pago en MercadoPago (approved, rejected, pending, etc.)
  mpStatus String @map("mp_status")

  /// Detalle del estado (ej: "accredited", "cc_rejected_insufficient_amount")
  mpStatusDetail String? @map("mp_status_detail")

  // === Montos ===

  /// Monto cobrado
  monto Decimal @db.Decimal(10, 2)

  /// Moneda del pago
  moneda String @default("ARS")

  // === Período cubierto ===

  /// Fecha de inicio del período que cubre este pago
  periodoInicio DateTime @map("periodo_inicio")

  /// Fecha de fin del período que cubre este pago
  periodoFin DateTime @map("periodo_fin")

  // === Intento ===

  /// Número de intento (1 = primer intento, 2+ = reintentos)
  intentoNumero Int @default(1) @map("intento_numero")

  /// Código de error si falló (ej: "cc_rejected_insufficient_amount")
  errorCode String? @map("error_code")

  /// Mensaje de error legible
  errorMessage String? @map("error_message")

  // === Fechas ===

  /// Fecha en que se realizó el cobro exitoso
  fechaCobro DateTime? @map("fecha_cobro")

  /// Timestamp de creación (fecha del intento)
  createdAt DateTime @default(now()) @map("created_at")

  // === Relaciones ===

  /// Suscripción a la que pertenece este pago
  suscripcion Suscripcion @relation(fields: [suscripcionId], references: [id], onDelete: Cascade)

  @@index([suscripcionId])
  @@map("pagos_suscripcion")
}

/// Historial de cambios de estado de suscripción
/// Para auditoría y trazabilidad
model HistorialEstadoSuscripcion {
  /// Identificador único del registro
  id String @id @default(cuid())

  /// ID de la suscripción
  suscripcionId String @map("suscripcion_id")

  /// Estado anterior (null si es el primer estado)
  estadoAnterior EstadoSuscripcion? @map("estado_anterior")

  /// Estado nuevo
  estadoNuevo EstadoSuscripcion @map("estado_nuevo")

  /// Motivo del cambio
  motivo String?

  /// Quién realizó el cambio: tutor_id, 'system', 'mercadopago'
  realizadoPor String? @map("realizado_por")

  /// Metadata adicional (JSON)
  metadata Json?

  /// Timestamp del cambio
  createdAt DateTime @default(now()) @map("created_at")

  // === Relaciones ===

  /// Suscripción a la que pertenece este historial
  suscripcion Suscripcion @relation(fields: [suscripcionId], references: [id], onDelete: Cascade)

  @@index([suscripcionId])
  @@map("historial_estado_suscripcion")
}

