  creadoEn DateTime @default(now()) @map("creado_en")

  // Para filtrar por casa (permite feed por casa)
  casaId String? @map("casa_id")

  // Relaciones
  estudiante Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  casa       Casa?      @relation(fields: [casaId], references: [id])

  // Reacciones al item del feed
  reacciones ReaccionFeed[]

  @@index([estudianteId])
  @@index([casaId])
  @@index([tipo])
  @@index([creadoEn])
  @@map("actividad_feed")
}

/// Reacciones a items del feed (emojis)
model ReaccionFeed {
  id String @id @default(cuid())

  // Item del feed al que se reacciona
  actividadId String @map("actividad_id")

  // Estudiante que reaccionó
  estudianteId String @map("estudiante_id")

  // Tipo de reacción (emoji)
  // Valores comunes: "👏", "🎉", "🔥", "💪", "❤️"
  emoji String

  // Timestamp
  creadoEn DateTime @default(now()) @map("creado_en")

  // Relaciones
  actividad  ActividadFeed @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  estudiante Estudiante    @relation(fields: [estudianteId], references: [id], onDelete: Cascade)

  // Un estudiante solo puede reaccionar una vez con el mismo emoji a un item
  @@unique([actividadId, estudianteId, emoji])
  @@index([actividadId])
  @@index([estudianteId])
  @@map("reacciones_feed")
}

