/// Estado de inscripción a una comisión
enum EstadoInscripcionComision {
  Pendiente
  Confirmada
  Cancelada
  ListaEspera
}

/// Modelo para comisiones (turnos/grupos) de productos
/// Una Comisión es una instancia operativa de un Producto con horario y cupo específico
/// Ejemplo: Producto "Colonia Verano 2026" → Comisiones: "QUANTUM Mañana", "VERTEX Tarde"
model Comision {
  /// Identificador único de la comisión
  id String @id @default(cuid())

  /// Nombre de la comisión (ej: "Turno Mañana", "QUANTUM Tarde")
  nombre String

  /// Descripción opcional
  descripcion String?

  /// Producto al que pertenece esta comisión
  productoId String   @map("producto_id")
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  /// Casa asignada (opcional - QUANTUM/VERTEX/PULSAR)
  casaId String? @map("casa_id")
  casa   Casa?   @relation(fields: [casaId], references: [id])

  /// Sistema Casa/Mundo 2026: Grupo pedagógico al que pertenece (opcional)
  /// Permite vincular comisiones a grupos específicos del sistema educativo
  grupoId String?          @map("grupo_id")
  grupo   GrupoPedagogico? @relation(fields: [grupoId], references: [id])

  /// Docente a cargo (opcional)
  docenteId String?  @map("docente_id")
  docente   Docente? @relation(fields: [docenteId], references: [id])

  /// Cupo máximo de estudiantes
  cupoMaximo Int? @map("cupo_maximo")

  /// Horario en texto libre (ej: "Lun-Vie 9:00-12:00")
  horario String?

  /// Fecha de inicio específica de esta comisión (puede diferir del producto)
  fechaInicio DateTime? @map("fecha_inicio")

  /// Fecha de fin específica de esta comisión
  fechaFin DateTime? @map("fecha_fin")

  /// Indica si la comisión está activa
  activo Boolean @default(true)

  /// Modalidad de la comisión: SINCRONICO (clase en vivo) o ASINCRONICO (contenido grabado)
  /// Independiente del tier del tutor - el tutor elige al comprar el producto
  modalidad TipoAccesoInscripcion @default(SINCRONICO)

  /// Planificación específica de esta comisión (override de la planificación del producto)
  /// Si es null, se usa la planificación del producto padre
  planificacionId String?        @map("planificacion_id")
  planificacion   Planificacion? @relation(fields: [planificacionId], references: [id])

  // ========== LIVEKIT - Clases en vivo ==========

  /// Nombre único de la sala en LiveKit (generado automáticamente)
  /// Formato: "comision_{id}_{timestamp}"
  livekitRoomName String? @unique @map("livekit_room_name")

  /// Estado actual de la clase en vivo
  estadoClase EstadoClase @default(Programada) @map("estado_clase")

  /// Timestamp de cuando el docente inició la clase en vivo
  iniciadaEn DateTime? @map("iniciada_en")

  /// Timestamp de cuando el docente finalizó la clase en vivo
  finalizadaEn DateTime? @map("finalizada_en")

  // ========== FIN LIVEKIT ==========

  /// Timestamp de creación
  createdAt DateTime @default(now())

  /// Timestamp de última actualización
  updatedAt DateTime @updatedAt

  /// Inscripciones de estudiantes a esta comisión
  inscripciones InscripcionComision[]

  /// Registros de asistencia en esta comisión
  asistencias AsistenciaComision[]

  /// Observaciones de docentes en esta comisión
  observaciones Observacion[]

  /// SISTEMA 2026: Inscripciones de actividad
  inscripcionesActividad InscripcionActividad[]

  /// SISTEMA 2026: Pagos de cursos temporales
  pagosCurso PagoCurso[]

  /// Anuncios publicados para esta comisión
  anuncios Anuncio[]

  @@index([productoId])
  @@index([docenteId])
  @@index([casaId])
  @@index([grupoId])
  @@index([planificacionId])
  @@index([activo])
  @@index([estadoClase])
  @@index([livekitRoomName])
  @@index([modalidad])
  @@map("comisiones")
}

/// Modelo para inscripciones de estudiantes a comisiones
/// Representa la relación entre un Estudiante y una Comisión de un Producto
model InscripcionComision {
  /// Identificador único de la inscripción
  id String @id @default(cuid())

  /// Comisión a la que se inscribe
  comisionId String   @map("comision_id")
  comision   Comision @relation(fields: [comisionId], references: [id], onDelete: Cascade)

  /// Estudiante inscrito
  estudianteId String     @map("estudiante_id")
  estudiante   Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)

  /// Estado de la inscripción
  estado EstadoInscripcionComision @default(Pendiente)

  /// Fecha de inscripción
  fechaInscripcion DateTime @default(now()) @map("fecha_inscripcion")

  /// Notas o comentarios sobre la inscripción
  notas String?

  /// Timestamp de última actualización
  updatedAt DateTime @updatedAt

  /// Un estudiante solo puede estar inscrito una vez por comisión
  @@unique([comisionId, estudianteId])
  @@index([estudianteId])
  @@index([estado])
  @@map("inscripciones_comision")
}

/// Modelo para registrar asistencia de estudiantes en comisiones
/// Permite trackear la asistencia por sesión/fecha en cada comisión
model AsistenciaComision {
  /// Identificador único del registro de asistencia
  id String @id @default(cuid())

  /// Comisión donde se registra la asistencia
  comisionId String   @map("comision_id")
  comision   Comision @relation(fields: [comisionId], references: [id], onDelete: Cascade)

  /// Estudiante al que corresponde la asistencia
  estudianteId String     @map("estudiante_id")
  estudiante   Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)

  /// Fecha de la sesión (solo fecha, sin hora)
  fecha DateTime @db.Date

  /// Estado de asistencia: Presente, Ausente, Justificado
  estado EstadoAsistencia

  /// Observación opcional del docente
  observacion String?

  /// Timestamp de creación
  createdAt DateTime @default(now()) @map("created_at")

  /// Un estudiante solo puede tener un registro de asistencia por comisión y fecha
  @@unique([comisionId, estudianteId, fecha])
  @@index([comisionId])
  @@index([estudianteId])
  @@index([fecha])
  @@map("asistencia_comision")
}

// =============================================================================
// TAREAS ADMINISTRATIVAS (Dashboard)
// =============================================================================

/// Modelo para tareas del dashboard administrativo
/// Permite a los administradores trackear pendientes y recordatorios
model TareaAdmin {
  /// Identificador único de la tarea
  id String @id @default(cuid())

  /// Título de la tarea
  title String

  /// Descripción detallada (opcional)
  description String?

  /// Prioridad: BAJA, MEDIA, ALTA, URGENTE
  priority PrioridadTarea @default(MEDIA)

  /// Estado: PENDIENTE, EN_PROGRESO, COMPLETADA, CANCELADA
  status EstadoTarea @default(PENDIENTE)

  /// Fecha límite (opcional)
  dueDate DateTime?

  /// Persona asignada (texto libre, opcional)
  assignee String?

  /// Timestamp de creación
  createdAt DateTime @default(now())

  /// Timestamp de última actualización
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@map("tareas_admin")
}

// =============================================================================
// SISTEMA DE PLANIFICACIONES DOCENTE v2
// Cursos de larga duración con clases, teoría/práctica y tareas
// =============================================================================

/// Planificación: un curso completo (ej: 16 clases de Scratch)
model Planificacion {
  id String @id @default(cuid())

  /// Título del curso/planificación
  titulo String

  /// Descripción del curso
  descripcion String?

  /// Cantidad total de clases en la planificación
  cantidadClases Int @map("cantidad_clases")

  /// Días entre clases (default: 7 = semanal)
  duracionClaseDias Int @default(7) @map("duracion_clase_dias")

  /// Casa objetivo (QUANTUM, VERTEX, PULSAR)
  casaTipo CasaTipo @map("casa_tipo")

  /// Mundo/materia (MATEMATICA, PROGRAMACION, CIENCIAS)
  mundoTipo MundoTipo @map("mundo_tipo")

  /// Estado de publicación
  estado EstadoContenido @default(BORRADOR)

  /// Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Relaciones
  clases       ClasePlanificacion[]
  asignaciones AsignacionPlanificacion[]
  /// Productos que usan esta planificación (Clubs)
  productos    Producto[]
  /// Comisiones que usan esta planificación (override de la del producto)
  comisiones   Comision[]

  @@index([casaTipo, mundoTipo])
  @@index([estado])
  @@map("planificaciones")
}

/// Clase dentro de una planificación (ej: Clase 1 de 16)
model ClasePlanificacion {
  id String @id @default(cuid())

  /// ID de la planificación padre
  planificacionId String @map("planificacion_id")

  /// Número de clase (1, 2, 3... cantidad_clases)
  numero Int

  /// Título de la clase
  titulo String

  /// Descripción/objetivos de la clase
  descripcion String?

  /// ID del contenido de TEORIA
  teoriaId String @map("teoria_id")

  /// ID del contenido de PRACTICA
  practicaId String @map("practica_id")

  /// Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Relaciones
  planificacion Planificacion @relation(fields: [planificacionId], references: [id], onDelete: Cascade)
  teoria        Contenido     @relation("ClaseTeoria", fields: [teoriaId], references: [id])
  practica      Contenido     @relation("ClasePractica", fields: [practicaId], references: [id])

  tareas         TareaClase[]
  estadosClase   EstadoClaseGrupo[]
  progresosClase ProgresoClaseEstudiante[]

  @@unique([planificacionId, numero])
  @@index([teoriaId])
  @@index([practicaId])
  @@map("clases_planificacion")
}

/// Tarea asociada a una clase (contenido asignable como tarea)
model TareaClase {
  id String @id @default(cuid())

  /// ID de la clase a la que pertenece
  claseId String @map("clase_id")

  /// ID del contenido que es la tarea
  contenidoId String @map("contenido_id")

  /// Orden de la tarea dentro de la clase
  orden Int @default(0)

  /// Si la tarea es obligatoria para completar la clase
  obligatoria Boolean @default(false)

  /// Relaciones
  clase     ClasePlanificacion @relation(fields: [claseId], references: [id], onDelete: Cascade)
  contenido Contenido          @relation(fields: [contenidoId], references: [id])

  asignaciones TareaAsignada[]

  @@unique([claseId, contenidoId])
  @@index([contenidoId])
  @@map("tareas_clase")
}

/// Asignación de una planificación a un ClaseGrupo por un docente
model AsignacionPlanificacion {
  id String @id @default(cuid())

  /// ID de la planificación
  planificacionId String @map("planificacion_id")

  /// ID del grupo de clase (comisión)
  claseGrupoId String @map("clase_grupo_id")

  /// ID del docente responsable
  docenteId String @map("docente_id")

  /// Fecha de inicio del curso para este grupo
  fechaInicio DateTime @default(now()) @map("fecha_inicio")

  /// Si la asignación está activa
  activa Boolean @default(true)

  /// Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Relaciones
  planificacion Planificacion @relation(fields: [planificacionId], references: [id])
  claseGrupo    ClaseGrupo    @relation(fields: [claseGrupoId], references: [id])
  docente       Docente       @relation(fields: [docenteId], references: [id])

  estadosClases   EstadoClaseGrupo[]
  tareasAsignadas TareaAsignada[]

  @@unique([planificacionId, claseGrupoId])
  @@index([docenteId])
  @@index([claseGrupoId])
  @@map("asignaciones_planificacion")
}

/// Estado de una clase para un grupo específico (qué está activo/desbloqueado)
model EstadoClaseGrupo {
  id String @id @default(cuid())

  /// ID de la asignación planificación-grupo
  asignacionId String @map("asignacion_id")

  /// ID de la clase
  claseId String @map("clase_id")

  /// Si la teoría está activa/visible para estudiantes
  teoriaActiva Boolean @default(false) @map("teoria_activa")

  /// Si la práctica está activa/visible para estudiantes
  practicaActiva Boolean @default(false) @map("practica_activa")

  /// Timestamp de cuando se activó la clase
  activadaEn DateTime? @map("activada_en")

  /// Timestamp de cuando se marcó como completada
  completadaEn DateTime? @map("completada_en")

  /// Relaciones
  asignacion AsignacionPlanificacion @relation(fields: [asignacionId], references: [id], onDelete: Cascade)
  clase      ClasePlanificacion      @relation(fields: [claseId], references: [id])

  @@unique([asignacionId, claseId])
  @@index([claseId])
  @@map("estados_clase_grupo")
}

/// Tarea asignada a un grupo (instancia de TareaClase para una asignación)
model TareaAsignada {
  id String @id @default(cuid())

  /// ID de la asignación planificación-grupo
  asignacionId String @map("asignacion_id")

  /// ID de la tarea de clase
  tareaClaseId String @map("tarea_clase_id")

  /// Fecha en que se asignó la tarea
  fechaAsignacion DateTime @default(now()) @map("fecha_asignacion")

  /// Fecha límite de entrega (opcional)
  fechaLimite DateTime? @map("fecha_limite")

  /// Si la tarea está activa/visible
  activa Boolean @default(true)

  /// Relaciones
  asignacion AsignacionPlanificacion @relation(fields: [asignacionId], references: [id], onDelete: Cascade)
  tareaClase TareaClase              @relation(fields: [tareaClaseId], references: [id])

  progresos ProgresoTareaEstudiante[]

  @@unique([asignacionId, tareaClaseId])
  @@index([tareaClaseId])
  @@map("tareas_asignadas")
}

/// Progreso de un estudiante en una clase (teoría + práctica)
model ProgresoClaseEstudiante {
  id String @id @default(cuid())

  /// ID del estudiante
  estudianteId String @map("estudiante_id")

  /// ID de la clase
  claseId String @map("clase_id")

  /// Si completó la teoría
  teoriaCompletada   Boolean   @default(false) @map("teoria_completada")
  teoriaCompletadaEn DateTime? @map("teoria_completada_en")

  /// Si completó la práctica
  practicaCompletada   Boolean   @default(false) @map("practica_completada")
  practicaCompletadaEn DateTime? @map("practica_completada_en")

  /// Tiempo dedicado en segundos
  tiempoTeoriaSegundos   Int @default(0) @map("tiempo_teoria_segundos")
  tiempoPracticaSegundos Int @default(0) @map("tiempo_practica_segundos")

  /// Relaciones
  estudiante Estudiante         @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  clase      ClasePlanificacion @relation(fields: [claseId], references: [id])

  @@unique([estudianteId, claseId])
  @@index([claseId])
  @@map("progresos_clase_estudiante")
}

/// Progreso de un estudiante en una tarea asignada
model ProgresoTareaEstudiante {
  id String @id @default(cuid())

  /// ID del estudiante
  estudianteId String @map("estudiante_id")

  /// ID de la tarea asignada
  tareaAsignadaId String @map("tarea_asignada_id")

  /// Estado de la tarea
  estado EstadoTarea @default(PENDIENTE)

  /// Timestamps de progreso
  iniciadaEn   DateTime? @map("iniciada_en")
  completadaEn DateTime? @map("completada_en")

  /// Métricas
  tiempoTotalSegundos Int    @default(0) @map("tiempo_total_segundos")
  intentos            Int    @default(0)
  calificacion        Float?

  /// Relaciones
  estudiante    Estudiante    @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  tareaAsignada TareaAsignada @relation(fields: [tareaAsignadaId], references: [id], onDelete: Cascade)

  @@unique([estudianteId, tareaAsignadaId])
  @@index([tareaAsignadaId])
  @@map("progresos_tarea_estudiante")
}

// ============================================================
// SISTEMA DE OBSERVACIONES DOCENTE
// ============================================================

/// Tipos de observación disponibles
enum TipoObservacion {
  Academica
  Conductual
  Asistencia
  Logro
  Incidente

  @@map("tipo_observacion")
}

/// Prioridad de la observación
enum PrioridadObservacion {
  Baja
  Media
  Alta
  Urgente

  @@map("prioridad_observacion")
}

/// Estado del ciclo de vida de la observación
enum EstadoObservacion {
  Abierta
  EnSeguimiento
  Resuelta
  Cerrada

  @@map("estado_observacion")
}

/// Tipo de autor de un seguimiento
enum TipoAutorSeguimiento {
  Docente
  Admin

  @@map("tipo_autor_seguimiento")
}

/// Observación de docente sobre estudiante(s)
/// Sistema inmutable para data analysis - NO se pueden eliminar
model Observacion {
  /// Identificador único
  id String @id @default(cuid())

  /// Docente que creó la observación
  docenteId String  @map("docente_id")
  docente   Docente @relation(fields: [docenteId], references: [id], onDelete: Cascade)

  /// Comisión/contexto donde ocurrió (opcional)
  comisionId String?   @map("comision_id")
  comision   Comision? @relation(fields: [comisionId], references: [id], onDelete: SetNull)

  /// Contenido de la observación
  contenido String @db.Text

  /// Fecha en que ocurrió el evento observado
  fechaEvento DateTime @map("fecha_evento")

  /// Clasificación
  tipo      TipoObservacion
  prioridad PrioridadObservacion @default(Baja)

  /// Flags de notificación
  requiereSeguimiento Boolean @default(false) @map("requiere_seguimiento")
  notificarAdmin      Boolean @default(false) @map("notificar_admin")
  notificarPedagogia  Boolean @default(false) @map("notificar_pedagogia")

  /// Estado del ciclo de vida
  estado EstadoObservacion @default(Abierta)

  /// Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Relaciones
  estudiantes  ObservacionEstudiante[]
  seguimientos SeguimientoObservacion[]

  @@index([docenteId])
  @@index([comisionId])
  @@index([tipo])
  @@index([prioridad])
  @@index([estado])
  @@index([requiereSeguimiento, estado])
  @@index([fechaEvento])
  @@index([createdAt])
  @@map("observaciones_docente")
}

/// Relación N:M entre Observación y Estudiante
/// Permite observaciones grupales (múltiples estudiantes)
model ObservacionEstudiante {
  observacionId String @map("observacion_id")
  estudianteId  String @map("estudiante_id")

  observacion Observacion @relation(fields: [observacionId], references: [id], onDelete: Cascade)
  estudiante  Estudiante  @relation(fields: [estudianteId], references: [id], onDelete: Cascade)

  @@id([observacionId, estudianteId])
  @@index([estudianteId])
  @@map("observaciones_estudiantes")
}

/// Seguimiento agregado a una observación
/// Inmutable: no se puede editar, solo agregar nuevos
model SeguimientoObservacion {
  /// Identificador único
  id String @id @default(cuid())

  /// Observación padre
  observacionId String      @map("observacion_id")
  observacion   Observacion @relation(fields: [observacionId], references: [id], onDelete: Cascade)

  /// Autor del seguimiento (puede ser docente o admin)
  autorId   String               @map("autor_id")
  autorTipo TipoAutorSeguimiento @map("autor_tipo")

  /// Contenido del seguimiento
  contenido String @db.Text

  /// Timestamp
  createdAt DateTime @default(now()) @map("created_at")

  @@index([observacionId])
  @@index([autorId])
  @@map("seguimientos_observacion")
}

// =============================================================================
// DEAD LETTER QUEUE - WEBHOOKS FALLIDOS
// Sprint 1: DLQ + Async Processing (Enero 2026)
// =============================================================================

/// Estado de webhooks en Dead Letter Queue
enum DlqStatus {
  PENDING /// Esperando ser procesado manualmente
  PROCESSING /// En proceso de reprocesamiento
  RESOLVED /// Resuelto exitosamente
  ABANDONED /// Marcado como abandonado (no se puede procesar)

  @@map("dlq_status")
}

/// Dead Letter Queue para webhooks de pago que fallaron múltiples veces
/// Permite a administradores ver, debuggear y reprocesar webhooks fallidos
model WebhookFailed {
  /// Identificador único
  id String @id @default(cuid())

  /// ID del pago de MercadoPago
  paymentId String @map("payment_id")

  /// Tipo de webhook (payment, subscription, etc.)
  webhookType String @map("webhook_type")

  /// Payload completo del webhook (para reprocesamiento)
  payload Json

  /// Mensaje de error del último intento
  errorMessage String @map("error_message")

  /// Stack trace del error (debugging)
  errorStack String? @map("error_stack")

  /// Número de reintentos realizados antes de ir a DLQ
  retries Int @default(0)

  /// Estado en la DLQ
  status DlqStatus @default(PENDING)

  /// Fecha del último reintento
  lastRetryAt DateTime? @map("last_retry_at")

  /// Fecha de resolución (si fue resuelto)
  resolvedAt DateTime? @map("resolved_at")

  /// Admin que resolvió (ID)
  resolvedBy String? @map("resolved_by")

  /// Notas de resolución
  resolutionNotes String? @map("resolution_notes")

  /// Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([paymentId])
  @@map("webhook_failed")
}

// =============================================================================
// SISTEMA DE SUSCRIPCIONES FAMILIARES (2026)
// Un solo PreApproval por familia con múltiples actividades
// =============================================================================

/// Suscripción familiar unificada
/// Representa un único PreApproval de MercadoPago que cubre todas las actividades de la familia
model SuscripcionFamiliar {
  /// Identificador único
  id String @id @default(cuid())

  /// Tutor titular de la suscripción (1 por familia)
  tutorId String @unique @map("tutor_id")
  tutor   Tutor  @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  // === MERCADOPAGO ===

  /// ID del PreApproval en MercadoPago
  preapprovalId String? @unique @map("preapproval_id")

  /// ID del plan de MercadoPago (si usamos plans)
  preapprovalPlanId String? @map("preapproval_plan_id")

  // === ESTADO ===

  /// Estado actual de la suscripción
  estado EstadoSuscripcionFamiliar @default(PENDING)

  // === FACTURACIÓN ===

  /// Tier seleccionado por la familia (define el precio base)
  tier TierNombre @default(STEAM_LIBROS)

  /// Monto mensual total calculado (suma de actividades con descuentos)
  montoMensual Int @default(0) @map("monto_mensual")

  /// Fecha del próximo cobro programado
  fechaProximoCobro DateTime? @map("fecha_proximo_cobro")

  /// Período de gracia por fallo de pago (fecha límite)
  fechaGracia DateTime? @map("fecha_gracia")

  // === CANCELACIÓN ===

  /// Fecha en que el tutor solicitó cancelar (para ventana de 24hs)
  fechaSolicitudCancelacion DateTime? @map("fecha_solicitud_cancelacion")

  /// Motivo de cancelación proporcionado por el tutor
  motivoCancelacion String? @map("motivo_cancelacion")

  // === VERANO ===

  /// Monto original del tier (para restaurar en marzo después de verano)
  montoOriginal Int? @map("monto_original")

  // === TIMESTAMPS ===

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // === RELACIONES ===

  /// Inscripciones de actividades de todos los estudiantes de la familia
  inscripciones InscripcionActividad[]

  /// Historial de cambios en inscripciones
  historialCambios CambioInscripcion[]

  /// VERANO: Decisiones de verano de cada estudiante de la familia
  decisionesVerano DecisionVeranoEstudiante[]

  @@index([estado])
  @@index([fechaProximoCobro])
  @@map("suscripciones_familiares")
}

// =============================================================================
// VERANO 2026: Decisiones de Verano por Estudiante
// =============================================================================

/// Decisión de verano de un estudiante dentro de una suscripción familiar
/// Cada estudiante puede elegir COLONIA o CONTINUIDAD independientemente
/// Se crea una entrada por estudiante por año
model DecisionVeranoEstudiante {
  /// Identificador único
  id String @id @default(cuid())

  // === RELACIONES ===

  /// Estudiante que toma la decisión
  estudianteId String     @map("estudiante_id")
  estudiante   Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)

  /// Suscripción familiar a la que pertenece
  suscripcionFamiliarId String              @map("suscripcion_familiar_id")
  suscripcionFamiliar   SuscripcionFamiliar @relation(fields: [suscripcionFamiliarId], references: [id], onDelete: Cascade)

  /// Si eligió COLONIA, grupo de Colonia asignado
  claseGrupoColoniaId String?     @map("clase_grupo_colonia_id")
  claseGrupoColonia   ClaseGrupo? @relation(fields: [claseGrupoColoniaId], references: [id])

  // === DATOS DE DECISIÓN ===

  /// Año de la decisión (2025, 2026, etc.)
  anio Int

  /// Decisión tomada
  decision DecisionVerano @default(PENDIENTE)

  /// Fecha y hora en que tomó la decisión
  fechaDecision DateTime? @map("fecha_decision")

  /// Si ya pagó la matrícula de Colonia ($40k) - NO REEMBOLSABLE
  matriculaColoniaPagada Boolean @default(false) @map("matricula_colonia_pagada")

  /// Motivo si fue forzado por admin (null si decidió el tutor)
  motivoAdmin String? @map("motivo_admin")

  // === TIMESTAMPS ===

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // === CONSTRAINTS ===

  /// Un estudiante solo puede tener una decisión por año
  @@unique([estudianteId, anio])
  @@index([suscripcionFamiliarId])
  @@index([anio, decision])
  @@map("decisiones_verano_estudiante")
}

/// Inscripción de un estudiante a una actividad
/// Representa la relación estudiante + producto + horario específico
model InscripcionActividad {
  /// Identificador único
  id String @id @default(cuid())

  // === RELACIONES PRINCIPALES ===

  /// Suscripción familiar a la que pertenece
  suscripcionFamiliarId String              @map("suscripcion_familiar_id")
  suscripcionFamiliar   SuscripcionFamiliar @relation(fields: [suscripcionFamiliarId], references: [id], onDelete: Cascade)

  /// Estudiante inscrito
  estudianteId String     @map("estudiante_id")
  estudiante   Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)

  /// Producto al que se inscribe
  productoId String   @map("producto_id")
  producto   Producto @relation(fields: [productoId], references: [id])

  // === ASIGNACIÓN ESPECÍFICA (uno u otro) ===

  /// ClaseGrupo para productos tipo Club
  claseGrupoId String?     @map("clase_grupo_id")
  claseGrupo   ClaseGrupo? @relation(fields: [claseGrupoId], references: [id])

  /// Comisión para cursos temporales
  comisionId String?   @map("comision_id")
  comision   Comision? @relation(fields: [comisionId], references: [id])

  // === TIER Y ESTADO ===

  /// Tier de esta inscripción específica (LIBROS, ASINCRONICO, SINCRONICO)
  /// Cada inscripción puede tener un tier diferente
  tier TierNombre?

  /// Estado de la inscripción
  estado EstadoInscripcionActividad @default(ACTIVA)

  /// Fecha de inicio de la inscripción
  fechaInicio DateTime @default(now()) @map("fecha_inicio")

  /// Fecha de fin (para cursos temporales o bajas)
  fechaFin DateTime? @map("fecha_fin")

  // === TIMESTAMPS ===

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([estudianteId, productoId, claseGrupoId])
  @@unique([estudianteId, comisionId])
  @@index([suscripcionFamiliarId])
  @@index([estudianteId])
  @@index([estado])
  @@map("inscripciones_actividad")
}

/// Historial de cambios en inscripciones
/// Registra altas, bajas, cambios de horario, producto y tier
model CambioInscripcion {
  /// Identificador único
  id String @id @default(cuid())

  /// Suscripción familiar afectada
  suscripcionFamiliarId String              @map("suscripcion_familiar_id")
  suscripcionFamiliar   SuscripcionFamiliar @relation(fields: [suscripcionFamiliarId], references: [id], onDelete: Cascade)

  /// Tipo de cambio realizado
  tipo TipoCambioInscripcion

  // === REFERENCIAS A INSCRIPCIONES ===

  /// ID de la inscripción anterior (para cambios)
  inscripcionAnteriorId String? @map("inscripcion_anterior_id")

  /// ID de la inscripción nueva (para altas y cambios)
  inscripcionNuevaId String? @map("inscripcion_nueva_id")

  // === CUÁNDO APLICA ===

  /// Fecha en que se solicitó el cambio
  solicitadoEn DateTime @default(now()) @map("solicitado_en")

  /// Fecha desde la cual aplica el cambio (siempre el 1ro del mes siguiente)
  aplicaDesde DateTime @map("aplica_desde")

  /// Indica si el cambio ya fue procesado
  procesado Boolean @default(false)

  // === MONTOS PARA REGISTRO HISTÓRICO ===

  /// Monto mensual antes del cambio
  montoAnterior Int @map("monto_anterior")

  /// Monto mensual después del cambio
  montoNuevo Int @map("monto_nuevo")

  /// Detalle adicional del cambio (JSON flexible)
  detalle Json?

  // === TIMESTAMPS ===

  createdAt DateTime @default(now()) @map("created_at")

  @@index([suscripcionFamiliarId])
  @@index([aplicaDesde, procesado])
  @@map("cambios_inscripcion")
}

/// Pago de curso temporal
/// Gestiona pagos únicos o en cuotas para productos que no son Club
model PagoCurso {
  /// Identificador único
  id String @id @default(cuid())

  // === RELACIONES ===

  /// Tutor que realiza el pago
  tutorId String @map("tutor_id")
  tutor   Tutor  @relation(fields: [tutorId], references: [id])

  /// Estudiante beneficiario
  estudianteId String     @map("estudiante_id")
  estudiante   Estudiante @relation(fields: [estudianteId], references: [id])

  /// Comisión a la que se inscribe
  comisionId String   @map("comision_id")
  comision   Comision @relation(fields: [comisionId], references: [id])

  /// Producto (para referencia rápida)
  productoId String   @map("producto_id")
  producto   Producto @relation(fields: [productoId], references: [id])

  // === MODALIDAD DE PAGO ===

  /// Modalidad: contado o cuotas
  modalidad ModalidadPagoCurso

  // === MONTOS ===

  /// Monto total del curso
  montoTotal Int @map("monto_total")

  /// Monto por cuota (si es en cuotas)
  montoPorCuota Int? @map("monto_por_cuota")

  /// Cantidad de cuotas (si es en cuotas)
  cantidadCuotas Int? @map("cantidad_cuotas")

  /// Cuotas ya pagadas
  cuotasPagadas Int @default(0) @map("cuotas_pagadas")

  // === MERCADOPAGO ===

  /// ID del payment de MercadoPago (pago único)
  paymentId String? @map("payment_id")

  /// ID del PreApproval de MercadoPago (para cuotas)
  preapprovalId String? @map("preapproval_id")

  // === ESTADO ===

  /// Estado del pago
  estado EstadoPagoCurso @default(PENDING)

  /// Fecha del pago inicial
  fechaPago DateTime? @map("fecha_pago")

  /// Fecha del próximo cobro (para cuotas)
  fechaProximoCobro DateTime? @map("fecha_proximo_cobro")

  // === TIMESTAMPS ===

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([estudianteId, comisionId])
  @@index([tutorId])
  @@index([estado])
  @@map("pagos_curso")
}

// ============================================================================
// VISTAS (Views) - Solo lectura
// ============================================================================

/// Vista unificada de inscripciones a ClaseGrupos
/// Combina inscripciones manuales (admin/becas) con suscripciones familiares (tutor 2026)
///
/// USAR ESTA VISTA en lugar de InscripcionClaseGrupo para consultas de LECTURA
///
/// Campos importantes:
/// - fuente: 'MANUAL' (admin) o 'SUSCRIPCION_2026' (tutor via suscripción)
/// - estado: 'ACTIVA', 'CANCELADA', o 'PAUSADA'
/// - tipo_acceso: 'SINCRONICO' o 'ASINCRONICO'
///
/// Para ESCRITURA:
/// - Manual (becas): usar InscripcionClaseGrupo
/// - Suscripción 2026: usar InscripcionActividad
view InscripcionUnificada {
  id                    String    @unique
  estudianteId          String    @map("estudiante_id")
  claseGrupoId          String    @map("clase_grupo_id")
  tutorId               String    @map("tutor_id")
  fechaInscripcion      DateTime  @map("fecha_inscripcion")
  fechaBaja             DateTime? @map("fecha_baja")
  tipoAcceso            String    @map("tipo_acceso") // 'SINCRONICO' | 'ASINCRONICO'
  observaciones         String?
  createdAt             DateTime  @map("created_at")
  updatedAt             DateTime  @map("updated_at")
  fuente                String // 'MANUAL' | 'SUSCRIPCION_2026'
  suscripcionFamiliarId String?   @map("suscripcion_familiar_id") // Solo para fuente SUSCRIPCION_2026
  productoId            String?   @map("producto_id") // Solo para fuente SUSCRIPCION_2026
  tier                  String? // Solo para fuente SUSCRIPCION_2026
  estado                String // 'ACTIVA' | 'CANCELADA' | 'PAUSADA'

  // Relaciones (read-only)
  estudiante Estudiante @relation("InscripcionUnificadaEstudiante", fields: [estudianteId], references: [id])
  claseGrupo ClaseGrupo @relation("InscripcionUnificadaClaseGrupo", fields: [claseGrupoId], references: [id])
  tutor      Tutor      @relation("InscripcionUnificadaTutor", fields: [tutorId], references: [id])

  @@map("inscripciones_unificadas")
}

// ============================================================================
// VISTA: FACTURACIÓN UNIFICADA (SSOT FINANCIERO)
// ============================================================================
/// Vista que unifica todas las fuentes de facturación:
/// - PagoSuscripcion: Pagos automáticos vía MercadoPago
/// - InscripcionMensual: Pagos manuales registrados por admin
///
/// USO:
/// - Dashboard financiero: métricas de ingresos consolidadas
/// - Reportes: sin duplicación de datos
/// - Historial de pagos: visión completa por tutor/familia
///
/// NOTA: Esta es una vista de SOLO LECTURA.
/// Para escribir, usar las tablas fuente correspondientes.
view FacturacionUnificada {
  id                    String    @unique
  fuente                String // 'SUSCRIPCION' | 'MANUAL'
  tutorId               String    @map("tutor_id")
  estudianteId          String?   @map("estudiante_id") // NULL para pagos de suscripción (nivel familia)
  periodo               String // "2026-01"
  anio                  Int
  mes                   Int
  monto                 Decimal   @db.Decimal(10, 2)
  estadoPago            String    @map("estado_pago") // 'Pagado' | 'Pendiente' | 'Vencido' | 'Parcial' | 'Anulado'
  metodoPago            String    @map("metodo_pago") // 'MercadoPago' | 'Efectivo' | 'Transferencia' | 'Manual'
  referenciaExterna     String?   @map("referencia_externa") // mp_payment_id para MercadoPago
  comprobanteUrl        String?   @map("comprobante_url")
  observaciones         String?
  fechaCreacion         DateTime  @map("fecha_creacion")
  fechaPago             DateTime? @map("fecha_pago")
  suscripcionFamiliarId String?   @map("suscripcion_familiar_id") // Solo para fuente SUSCRIPCION
  inscripcionMensualId  String?   @map("inscripcion_mensual_id") // Solo para fuente MANUAL

  // Relaciones (read-only)
  tutor      Tutor       @relation("FacturacionUnificadaTutor", fields: [tutorId], references: [id])
  estudiante Estudiante? @relation("FacturacionUnificadaEstudiante", fields: [estudianteId], references: [id])

  @@map("facturacion_unificada")
}

// ============================================================================
// SISTEMA DE ANUNCIOS DOCENTE → GRUPO
// ============================================================================

/// Tipo de anuncio que define su nivel de importancia
enum TipoAnuncio {
  /// Información general, no urgente
  INFORMATIVO
  /// Información relevante que requiere atención
  IMPORTANTE
  /// Información crítica que requiere acción inmediata
  URGENTE
}

/// Modelo para anuncios de docentes a sus grupos/comisiones
/// Permite comunicación unidireccional docente → tutores/estudiantes
model Anuncio {
  /// Identificador único del anuncio
  id String @id @default(cuid())

  /// Docente que crea el anuncio
  docenteId String  @map("docente_id")
  docente   Docente @relation(fields: [docenteId], references: [id], onDelete: Cascade)

  /// Comisión destinataria (null = todas las comisiones del docente)
  comisionId String?   @map("comision_id")
  comision   Comision? @relation(fields: [comisionId], references: [id], onDelete: Cascade)

  /// Título del anuncio (máx 200 caracteres)
  titulo String @db.VarChar(200)

  /// Contenido del anuncio
  contenido String @db.Text

  /// Tipo/prioridad del anuncio
  tipo TipoAnuncio @default(INFORMATIVO)

  /// Fecha de expiración (después de esta fecha el anuncio no se muestra)
  fechaExpiracion DateTime? @map("fecha_expiracion")

  /// Indica si el anuncio está activo (permite desactivar sin eliminar)
  activo Boolean @default(true)

  /// Timestamp de creación
  createdAt DateTime @default(now()) @map("created_at")

  /// Timestamp de última actualización
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([docenteId])
  @@index([comisionId])
  @@index([tipo])
  @@index([activo])
  @@index([fechaExpiracion])
  @@index([createdAt])
  @@map("anuncios")
}

// ============================================================================
// SISTEMA DE ALERTAS PARA ADMIN
// ============================================================================

/// Tipos de alertas que puede recibir un administrador
enum TipoAlertaAdmin {
  /// Nueva suscripción creada por un tutor
  NUEVA_SUSCRIPCION
  /// Tutor canceló su suscripción
  SUSCRIPCION_CANCELADA
  /// Pago rechazado o fallido
  PAGO_FALLIDO
  /// Estudiante sin actividad por X días
  ESTUDIANTE_INACTIVO
  /// Posible actividad fraudulenta detectada
  FRAUDE_DETECTADO
  /// Webhook de MercadoPago falló
  WEBHOOK_FALLIDO
  /// Alerta del sistema (errores, problemas técnicos)
  SISTEMA
  /// Suscripción en período de gracia
  SUSCRIPCION_GRACE_PERIOD
}

/// Modelo para alertas del administrador
/// Centraliza eventos importantes que requieren atención del admin
model AlertaAdmin {
  /// Identificador único de la alerta
  id String @id @default(cuid())

  /// Tipo de alerta
  tipo TipoAlertaAdmin

  /// Título breve de la alerta
  titulo String @db.VarChar(200)

  /// Mensaje detallado de la alerta
  mensaje String @db.Text

  /// Prioridad de la alerta (usa el enum existente)
  prioridad PrioridadNotificacion @default(MEDIA)

  /// Indica si la alerta fue resuelta/atendida
  resuelta Boolean @default(false)

  /// ID del admin que resolvió la alerta
  resueltaPorId String? @map("resuelta_por_id")

  /// Fecha en que se resolvió la alerta
  fechaResolucion DateTime? @map("fecha_resolucion")

  /// Metadata adicional (IDs relacionados, detalles, etc.)
  metadata Json?

  /// Timestamp de creación
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tipo])
  @@index([prioridad])
  @@index([resuelta])
  @@index([createdAt])
  @@map("alertas_admin")
}
