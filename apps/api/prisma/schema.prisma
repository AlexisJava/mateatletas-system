/// Configuración global de precios (Tabla singleton)
/// Solo existe UN registro con id="singleton"
/// Sistema de Tiers STEAM 2026: STEAM_LIBROS, STEAM_ASINCRONICO, STEAM_SINCRONICO
model ConfiguracionPrecios {
  /// ID fijo "singleton" para garantizar un solo registro
  id String @id @default("singleton")

  /// Precios por Tier STEAM (Sistema 2026)
  precioSteamLibros      Decimal @default(40000) @map("precio_steam_libros") @db.Decimal(10, 2)
  precioSteamAsincronico Decimal @default(65000) @map("precio_steam_asincronico") @db.Decimal(10, 2)
  precioSteamSincronico  Decimal @default(95000) @map("precio_steam_sincronico") @db.Decimal(10, 2)

  /// Descuento familiar simplificado
  descuentoSegundoHermano Decimal @default(10) @map("descuento_segundo_hermano") @db.Decimal(5, 2) // 10% para 2do hermano en adelante

  /// Configuración de notificaciones
  diaVencimiento        Int     @default(15) @map("dia_vencimiento")
  diasAntesRecordatorio Int     @default(5) @map("dias_antes_recordatorio")
  notificacionesActivas Boolean @default(true) @map("notificaciones_activas")

  /// Metadata
  actualizadoPorAdminId String?  @map("actualizado_por_admin_id")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  /// Relaciones
  historial HistorialCambioPrecios[]

  @@map("configuracion_precios")
}

/// Historial de cambios en la configuración de precios
/// Auditoría completa de modificaciones
model HistorialCambioPrecios {
  /// Identificador único del cambio
  id String @id @default(cuid())

  /// Referencia a la configuración
  configuracionId String @map("configuracion_id")

  /// Valores antes y después del cambio (JSON flexible)
  valoresAnteriores Json @map("valores_anteriores")
  valoresNuevos     Json @map("valores_nuevos")

  /// Metadata del cambio
  motivoCambio String?  @map("motivo_cambio")
  adminId      String   @map("admin_id")
  fechaCambio  DateTime @default(now()) @map("fecha_cambio")

  /// Relaciones
  configuracion ConfiguracionPrecios @relation(fields: [configuracionId], references: [id])

  @@index([configuracionId])
  @@index([fechaCambio])
  @@map("historial_cambio_precios")
}

/// Inscripción mensual de un estudiante a un producto
/// Reemplaza el concepto de "reserva" por facturación mensual
model InscripcionMensual {
  /// Identificador único
  id String @id @default(cuid())

  /// Relaciones principales
  estudianteId String @map("estudiante_id")
  productoId   String @map("producto_id")
  tutorId      String @map("tutor_id")

  /// Período de facturación
  anio    Int
  mes     Int // 1-12
  periodo String // "2025-01" para facilitar queries

  /// Cálculo de precios (guardado para historial)
  precioBase        Decimal @map("precio_base") @db.Decimal(10, 2)
  descuentoAplicado Decimal @default(0) @map("descuento_aplicado") @db.Decimal(10, 2)
  precioFinal       Decimal @map("precio_final") @db.Decimal(10, 2)

  /// Metadata del cálculo
  tipoDescuento  TipoDescuento @map("tipo_descuento")
  detalleCalculo String        @map("detalle_calculo") // Explicación del cálculo aplicado

  /// Estado de pago
  estadoPago       EstadoPago @default(Pendiente) @map("estado_pago")
  montoPagado      Decimal    @default(0) @map("monto_pagado") @db.Decimal(10, 2) // Monto acumulado de pagos
  fechaVencimiento DateTime?  @map("fecha_vencimiento") // Fecha límite de pago
  fechaPago        DateTime?  @map("fecha_pago")
  metodoPago       String?    @map("metodo_pago") // "Efectivo", "Transferencia", "MercadoPago"
  comprobanteUrl   String?    @map("comprobante_url") // URL del comprobante subido
  observaciones    String?

  /// Auditoría
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Relaciones
  estudiante Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  producto   Producto   @relation(fields: [productoId], references: [id])
  tutor      Tutor      @relation(fields: [tutorId], references: [id])

  @@unique([estudianteId, productoId, periodo])
  @@index([tutorId, periodo])
  @@index([estadoPago])
  @@index([periodo])
  @@map("inscripciones_mensuales")
}

