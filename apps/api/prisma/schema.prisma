  // Mensaje legible para mostrar en el feed
  // Ej: "Lucas completó la Clase 3: Introducción a Variables"
  mensaje String

  // XP ganado por esta actividad (para mostrar en el feed)
  xp_ganado Int @default(0)

  // Metadata adicional (JSON flexible)
  // Puede incluir: claseId, planificacionId, logroId, etc.
  metadata Json @default("{}")

  // Timestamp de la actividad
  creado_en DateTime @default(now())

  // Para filtrar por casa (permite feed por casa)
  casa_id String?

  // Relaciones
  estudiante Estudiante @relation(fields: [estudiante_id], references: [id], onDelete: Cascade)
  casa       Casa?      @relation(fields: [casa_id], references: [id])

  // Reacciones al item del feed
  reacciones ReaccionFeed[]

  @@index([estudiante_id])
  @@index([casa_id])
  @@index([tipo])
  @@index([creado_en])
  @@map("actividad_feed")
}

/// Reacciones a items del feed (emojis)
model ReaccionFeed {
  id String @id @default(cuid())

  // Item del feed al que se reacciona
  actividad_id String

  // Estudiante que reaccionó
  estudiante_id String

  // Tipo de reacción (emoji)
  // Valores comunes: "👏", "🎉", "🔥", "💪", "❤️"
  emoji String

  // Timestamp
  creado_en DateTime @default(now())

  // Relaciones
  actividad  ActividadFeed @relation(fields: [actividad_id], references: [id], onDelete: Cascade)
  estudiante Estudiante    @relation(fields: [estudiante_id], references: [id], onDelete: Cascade)

  // Un estudiante solo puede reaccionar una vez con el mismo emoji a un item
  @@unique([actividad_id, estudiante_id, emoji])
  @@index([actividad_id])
  @@index([estudiante_id])
  @@map("reacciones_feed")
}

