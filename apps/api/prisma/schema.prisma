  TAREA // Trabajo asignable
  MICROLECCION // Cápsula autoguiada
  EVALUACION // Quiz, examen
  JUEGO // Minijuego Phaser
  SIMULACION // Experimento interactivo
  RECURSO // Material de consulta (no se completa)

  @@map("tipo_contenido")
}

/// Enum para estado del onboarding del estudiante (2026)
