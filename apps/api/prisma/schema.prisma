enum TierNombre {
  STEAM_LIBROS // $40k - Plataforma completa (Mate + Progra + Ciencias)
  STEAM_ASINCRONICO // $65k - Todo + clases grabadas
  STEAM_SINCRONICO // $95k - Todo + clases en vivo con docente

  @@map("tier_nombre")
}

